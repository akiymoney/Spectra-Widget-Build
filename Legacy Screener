  .ecu-body{height:144px;padding:5px 8px}
  .ecu-body textarea{
    width:100%;height:100%;resize:none;border:1px solid rgba(255,255,255,.12);background:#09101e;color:#e6edf7;border-radius:8px;padding:8px;font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace
  }
  .ecu-head .btn{height:21px;padding:0 8px;border-radius:5px;border:1px solid rgba(255,255,255,.15);background:#0e182c;color:#d7e0ef;cursor:pointer}
  .ecu-head .btn:hover{filter:brightness(1.1)}
