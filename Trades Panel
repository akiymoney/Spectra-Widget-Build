<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>CYCLA • Trades Panel (233×523 Container)</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    /* ───────────────────────── Theme Tokens ───────────────────────── */
    :root{
      --bg:#0a0f1a;
      --panel:#0e1526;
      --panel-2:#0c1323;
      --text:#e6edf7;
      --muted:#9aa5b1;
      --border:rgba(255,255,255,.12);
      --border-soft:rgba(255,255,255,.06);
      --lift-1:0 16px 48px rgba(1,7,20,.55);
      --lift-2:0 3px 12px rgba(1,7,20,.35);
      --rim:0 0 0 1px rgba(255,255,255,.04) inset, 0 1px 0 rgba(255,255,255,.06) inset;
    }
    @media (prefers-color-scheme: dark){
      :root{ --bg:#070c16; }
    }

    /* Page frame (demo only: center the main container on the page) */
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      display:grid;
      place-items:center;
      background:radial-gradient(1597px 987px at 21% -13%, #0d1730 0%, var(--bg) 55%) fixed;
      font:13px/1.3 system-ui, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
      color:var(--text);
    }

    /* ───────────────────────── Main Container (233×523) ───────────────────────── */
    .spectra-container{
      width:233px;
      height:523px;
      display:grid;
      place-items:center;     /* centers the widget */
      overflow:hidden;        /* ensure a clean fit */
      /* (optional) visualize the container bounds during dev: */
      /* outline:1px dashed rgba(255,255,255,.15); */
    }

    /* ───────────────────────── Widget (fills container) ───────────────────────── */
    .spectra-widget{
      width:100%;
      height:100%;
      border:3px solid var(--border);
      border-radius:13px;
      background:
        linear-gradient(180deg, rgba(18,26,46,.96), rgba(9,14,26,.96)),
        radial-gradient(987px 610px at 21% -13%, rgba(86,122,255,.04), transparent 40%),
        var(--panel);
      box-shadow:var(--lift-1), var(--lift-2), var(--rim);
      backdrop-filter:blur(8px);
      -webkit-backdrop-filter:blur(8px);
      overflow:hidden;
      user-select:none;
      will-change:transform;
      transition:transform .13s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .spectra-widget:hover{
      transform:translateY(-1px);
      box-shadow:0 21px 55px rgba(1,7,20,.6), var(--lift-2), var(--rim);
      border-color:rgba(255,255,255,.16);
    }

    /* Header */
    .spectra-head{
      height:34px;
      display:flex; align-items:center; justify-content:space-between;
      padding:0 8px 0 13px;
      background:linear-gradient(180deg, rgba(255,255,255,.05), transparent);
      border-bottom:1px solid var(--border-soft);
      letter-spacing:.2px;
    }
    .brand{ font-size:13px; font-weight:610; opacity:.8; }
    .dots{ display:inline-flex; gap:3px; }
    .dot{
      width:5px; height:5px; border-radius:55%;
      background:rgba(255,255,255,.42);
    }

    /* Body */
    .spectra-body{
      position:relative;
      height:calc(100% - 34px);
      display:flex; align-items:center; justify-content:center;
      color:var(--muted);
      text-align:center;
      padding:8px;
    }
    .spectra-note{
      opacity:.89;
      font-size:13px;
      font-weight:610;
      text-shadow:0 1px 0 rgba(0,0,0,.6);
    }
    .spectra-body::after{
      content:"";
      position:absolute; inset:0;
      pointer-events:none;
      box-shadow:inset 0 0 144px rgba(0,0,0,.35);
      border-radius:13px;
    }

    /* Footer (mini status strip) */
    .spectra-foot{
      position:absolute; left:8px; bottom:8px;
      font-size:13px; color:rgba(230,237,247,.55);
      padding:2px 5px; border-radius:5px;
      background:rgba(255,255,255,.04);
      border:1px solid var(--border-soft);
      box-shadow:0 1px 0 rgba(255,255,255,.04) inset;
    }

    .hidden{ display:none !important; }
  </style>
</head>
<body>

  <!-- ───────────────────── Main Container (233 × 523 px) ───────────────────── -->
  <main class="spectra-container" aria-label="Main container 233×523">
    <!-- ───────────────── Trades Widget (fills container) ───────────────── -->
    <aside class="spectra-widget" aria-label="Trades Panel">
      <header class="spectra-head" aria-label="CYCLA Trades Header">
        <div class="brand">CYCLA • Trades</div>
        <div class="dots" aria-hidden="true">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        </div>
      </header>

      <div class="spectra-body">
        <div class="spectra-note">Trades Panel (fits 233 × 523)</div>
        <div class="spectra-foot">Ready</div>
      </div>
    </aside>
  </main>

</body>
</html>
