<!-- CYCLA • Trades Widget (255x523) • Squarespace-ready -->
<div id="cycla-trades-center">
  <div id="cycla-trades-widget" role="region" aria-label="Trades widget">
    <!-- Widget label -->
    <div class="widget-label">Trades</div>

    <!-- HUD stack -->
    <div class="hud pl">
      <div class="hud-head">
        <span class="hud-title">P/L</span>
        <span class="dots" aria-hidden="true">···</span>
      </div>
      <div class="hud-body">
        <!-- placeholder content -->
        <div class="metric">
          <div class="metric-num">+$0.00</div>
          <div class="metric-sub">Realized / Unrealized</div>
        </div>
      </div>
    </div>

    <div class="hud watchlist">
      <div class="hud-head">
        <span class="hud-title">Watchlist</span>
        <span class="dots" aria-hidden="true">···</span>
      </div>
      <div class="hud-body list">
        <div class="row"><span>BTC-USD</span><span>—</span></div>
        <div class="row"><span>ETH-USD</span><span>—</span></div>
        <div class="row"><span>ADA-USD</span><span>—</span></div>
      </div>
    </div>

    <div class="hud trades">
      <div class="hud-head">
        <span class="hud-title">Active Trades</span>
        <span class="dots" aria-hidden="true">···</span>
      </div>
      <div class="hud-body list">
        <div class="row"><span>—</span><span>—</span></div>
        <div class="row"><span>—</span><span>—</span></div>
        <div class="row"><span>—</span><span>—</span></div>
      </div>
    </div>

    <!-- Bottom buttons -->
    <div class="btn-row">
      <button class="btn" type="button" aria-label="Enable Autopilot">AUTO</button>
      <button class="btn ks" type="button" aria-label="Kill Switch">KS</button>
    </div>
  </div>
</div>

<style>
  /* ───────────────────────── Scoped to this block ───────────────────────── */
  #cycla-trades-center * { box-sizing: border-box; }

  /* Center the widget perfectly inside the Squarespace code block */
  #cycla-trades-center{
    width:100%;
    min-height:523px;                 /* equals widget height, ensures true centering */
    display:grid;
    place-items:center;               /* centers both axes */
    padding:0; margin:0 auto;
  }

  /* The widget container: fixed 255x523 */
  #cycla-trades-widget{
    width:255px; height:523px;
    position:relative;
    font: 13px/1.25 system-ui, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    color:#0b1220;
    border-radius:14px;
    background:#f6f8fc;
    border:1px solid rgba(10,20,40,.12);
    box-shadow:
      0 18px 55px rgba(8,16,40,.28),
      0 2px 10px rgba(8,16,40,.12);
    padding:10px;                     /* inner gutter */
    overflow:hidden;
  }

  /* Widget label (top-left) */
  #cycla-trades-widget .widget-label{
    position:absolute; top:8px; left:10px;
    font-weight:700; font-size:12px; letter-spacing:.4px;
    color:#3b4a6b;
    background:rgba(255,255,255,.75);
    border:1px solid rgba(10,20,40,.12);
    padding:4px 8px; border-radius:8px;
    backdrop-filter:saturate(140%) blur(4px);
    pointer-events:none;
  }

  /* HUD cards (233x144) */
  .hud{
    width:233px; height:144px;
    margin:0 auto 6px auto;           /* 6px gap between cards */
    border-radius:16px;
    border:1px solid rgba(10,20,40,.10);
    overflow:hidden;
    display:flex; flex-direction:column;
    box-shadow: 0 8px 24px rgba(8,16,40,.18);
  }
  .hud:last-of-type{ margin-bottom:8px; }

  /* Per-card pastel tints (matching the screenshot vibe) */
  .hud.pl{        background:linear-gradient(180deg,#dff0ff 0%,#cfe6ff 100%); }
  .hud.watchlist{ background:linear-gradient(180deg,#f2e6ff 0%,#e6d6ff 100%); }
  .hud.trades{    background:linear-gradient(180deg,#dbffe7 0%,#c9ffd9 100%); }

  /* HUD head */
  .hud-head{
    height:30px; display:flex; align-items:center; justify-content:space-between;
    padding:0 10px;
    background:rgba(255,255,255,.55);
    border-bottom:1px solid rgba(10,20,40,.08);
    font-weight:700; color:#33415e;
  }
  .hud-title{ font-size:12px; }
  .dots{ letter-spacing:3px; opacity:.6; }

  /* HUD body */
  .hud-body{ flex:1; padding:10px; display:flex; align-items:center; justify-content:center; }

  .metric{ text-align:center; }
  .metric-num{ font-size:22px; font-weight:800; margin-bottom:4px; color:#1b2a4a; }
  .metric-sub{ font-size:11px; color:#4b5a7a; }

  .list{ align-items:stretch; justify-content:flex-start; }
  .list .row{
    display:flex; align-items:center; justify-content:space-between;
    padding:6px 8px; margin:3px 0; border-radius:10px;
    background:rgba(255,255,255,.65);
    border:1px solid rgba(10,20,40,.06);
  }

  /* Bottom buttons row */
  .btn-row{
    width:100%; display:flex; gap:8px; justify-content:center; align-items:center;
    position:absolute; left:0; right:0; bottom:8px;
  }
  .btn{
    width:55px; height:34px;
    border-radius:10px; font-weight:800; letter-spacing:.3px;
    background:#ffffff; border:2px solid rgba(10,20,40,.15);
    box-shadow: 0 4px 12px rgba(8,16,40,.12);
    cursor:pointer;
  }
  .btn:hover{ transform:translateY(-1px); transition:transform .08s ease; }
  .btn:active{ transform:translateY(0); }

  /* Kill Switch: red outline */
  .btn.ks{
    background:#fff;
    border:2px solid #ff4d4f;
    color:#b0000a;
  }

  /* Small safety for narrow parent containers */
  @media (max-width: 260px){ #cycla-trades-widget{ transform:scale(.98); transform-origin:center; } }
</style>
