<!-- Lightweight Charts (small, CDN) -->
<script src="https://unpkg.com/lightweight-charts@4.2.1/dist/lightweight-charts.standalone.production.js"></script>

<script>
(()=>{
  // ───────────────────────── Config / Theme ─────────────────────────
  const ROOT = document.getElementById('cycla-chart-widget');
  const TD_KEY = ROOT.getAttribute('data-td-key') || '';

  const DEFAULT_SYMBOL = 'BTC-USD';

  // ► TZ PATCH: force all displayed times to Houston, TX (America/Chicago)
  const TIMEZONE = 'America/Chicago';
  const LOCALE = 'en-US';

  // ► TwelveData outputsize safety cap to keep custom TFs working
  const TD_LIMIT = 5000;

  const INFO = {
    box:  ROOT.querySelector('.cp-info'),
    sym:  ROOT.querySelector('.cp-info .sym'),
    name: ROOT.querySelector('.cp-info .name'),
    last: ROOT.querySelector('.cp-info .last')
  };
  const TF_BTN  = ROOT.querySelector('.cp-tf');
  const TF_MENU = ROOT.querySelector('#cp-tf-menu');
  const SEARCH  = ROOT.querySelector('#cp-search');
  const W_BTN   = ROOT.querySelector('.cp-w');
  const TIP     = ROOT.querySelector('#cp-tip');
  const TIP_OSC = ROOT.querySelector('#cp-tip-osc');

  // Chart theme (teal/purple)
  const COLORS = {
    up: '#14B8A6',
    upBorder: '#0F766E',
    down: '#723085',
    downBorder: '#6D28D9',
    wick: '#0A1F33',
    grid: 'rgba(10,20,40,.10)',
    text: '#1b2a4a',
    band: 'rgba(27,42,74,.55)',
    bandLo: 'rgba(27,42,74,.35)',
    zero: 'rgba(27,42,74,.25)',
  };

  // TF map: native vs resample (from 1min)
  const TF = {
    '1m': { kind:'native', td:'1min' },
    '3m': { kind:'resample', base:'1min', mult:3 },
    '5m': { kind:'native', td:'5min' },
    '8m': { kind:'resample', base:'1min', mult:8 },
    '13m':{ kind:'resample', base:'1min', mult:13 },
    '21m':{ kind:'resample', base:'1min', mult:21 },
    '34m':{ kind:'resample', base:'1min', mult:34 },
    '1H': { kind:'native', td:'1h' },
    '1D': { kind:'native', td:'1day' },
    '1M': { kind:'native', td:'1month' },
  };

  // ───────────────────────── Utilities ─────────────────────────
  const normalizeSymbol = (s) => s.replace(/-/g,'/').toUpperCase(); // BTC-USD → BTC/USD
  const toEpoch = (iso) => Math.floor(new Date(iso.replace(' ', 'T')+'Z').getTime()/1000); // keep UTC from API
  const clamp = (v,min,max)=>Math.max(min,Math.min(max,v));

  function timeToDate(t){
    if(typeof t === 'number'){ return new Date(t * 1000); }
    if(t && typeof t === 'object' && 'timestamp' in t){ return new Date(t.timestamp * 1000); }
    if(t && typeof t === 'object' && 'year' in t){
      return new Date(Date.UTC(t.year, (t.month||1)-1, t.day||1, 12, 0, 0));
    }
    return new Date(0);
  }

  // Formatters
  const fmtTime    = new Intl.DateTimeFormat(LOCALE, { timeZone: TIMEZONE, hour:'2-digit', minute:'2-digit' });
  const fmtTimeSec = new Intl.DateTimeFormat(LOCALE, { timeZone: TIMEZONE, hour:'2-digit', minute:'2-digit', second:'2-digit' });
  const fmtDay     = new Intl.DateTimeFormat(LOCALE, { timeZone: TIMEZONE, month:'short', day:'2-digit' });
  const fmtDateDow = new Intl.DateTimeFormat(LOCALE, { timeZone: TIMEZONE, weekday:'short', month:'short', day:'2-digit', year:'numeric' });
  const fmtMonth   = new Intl.DateTimeFormat(LOCALE, { timeZone: TIMEZONE, month:'short', year:'numeric' });
  const fmtYear    = new Intl.DateTimeFormat(LOCALE, { timeZone: TIMEZONE, year:'numeric' });

  const MIDDAY_SHIFT_MS = 12 * 60 * 60 * 1000;
  function shiftedIfDateOnly(d, tf){
    if(tf === '1D' || tf === '1M') return new Date(d.getTime() + MIDDAY_SHIFT_MS);
    return d;
  }

  function tickMarkFormatter(t, type){
    const d = timeToDate(t);
    switch(type){
      case 'year':             return fmtYear.format(d);
      case 'month':            return fmtMonth.format(d);
      case 'day_of_month':     return fmtDay.format(d);
      case 'time_with_seconds':return fmtTimeSec.format(d);
      default:                 return fmtTime.format(d);
    }
  }

  function crosshairTimeFormatter(t, tf){
    let d = timeToDate(t);
    d = shiftedIfDateOnly(d, tf);
    if(tf === '1M') return fmtMonth.format(d);
    if(tf === '1D') return fmtDateDow.format(d);
    const hasSeconds = (tf === '1m' || tf === '3m' || tf === '5m' || tf === '8m' || tf === '13m' || tf === '21m' || tf === '34m');
    return fmtDateDow.format(d) + ' ' + (hasSeconds ? fmtTimeSec.format(d) : fmtTime.format(d));
  }

  // Resampling
  function resampleOHLC(bars, seconds){
    if(!bars.length) return [];
    const out = [];
    const start = Math.floor(bars[0].time / seconds) * seconds;
    let bucketStart = start, bucketEnd = start + seconds;
    let cur = null;

    for(const b of bars){
      while(b.time >= bucketEnd){
        if(cur){ out.push(cur); cur = null; }
        bucketStart = bucketEnd;
        bucketEnd += seconds;
      }
      if(!cur){
        cur = { time: bucketStart, open:b.open, high:b.high, low:b.low, close:b.close };
      }else{
        cur.high = Math.max(cur.high, b.high);
        cur.low  = Math.min(cur.low,  b.low);
        cur.close = b.close;
      }
    }
    if(cur){ out.push(cur); }
    return out;
  }

  // ───────────────────────── SMFT Candles (variable-alpha EMA) ─────────────────────────
  const SMFT_PARAMS = { xi: 3.0, eSatPct: 8.0, gamma: 8.0, atrLen: 5 };

  function trueRange(h, l, prevClose){
    if(prevClose == null) return h - l;
    const a = h - l;
    const b = Math.abs(h - prevClose);
    const c = Math.abs(l - prevClose);
    return Math.max(a, b, c);
  }
  function rmaNext(prev, x, len){ if(prev == null) return x; return (prev * (len - 1) + x) / len; }
  function smftAlpha(atrPct, p){ const xiMem = Math.max(1, p.xi / (1 + Math.pow(atrPct / p.eSatPct, p.gamma))); return 2 / (xiMem + 1); }

  function buildSMFT(bars, p=SMFT_PARAMS){
    let prevClose = null, atrRma = null;
    let oP = null, hP = null, lP = null, cP2 = null;
    const out = [];
    const atrPctArr = [];
    for(const b of bars){
      const tr = trueRange(b.high, b.low, prevClose);
      atrRma = rmaNext(atrRma, tr, p.atrLen);
      const atrPct = (atrRma / (b.close || 1)) * 100;
      const alpha = smftAlpha(atrPct, p);

      if(oP == null){ oP=b.open; hP=b.high; lP=b.low; cP2=b.close; }
      else{
        oP  = oP  + alpha * (b.open  - oP);
        hP  = hP  + alpha * (b.high  - hP);
        lP  = lP  + alpha * (b.low   - lP);
        cP2 = cP2 + alpha * (b.close - cP2);
      }
      const prevCloseSmft = out.length ? out[out.length - 1].close : cP2;
      const rising = cP2 > prevCloseSmft;
      out.push({ time:b.time, open:oP, high:hP, low:lP, close:cP2, color: rising ? COLORS.up : COLORS.down });
      atrPctArr.push(atrPct);
      prevClose = b.close;
    }
    return { bars: out, atrPctArr, state: { prevClose, atrRma, oP, hP, lP, cP2, params: p } };
  }

  function smftStep(state, tailBars, outArrRef, atrPctArrRef){
    const p = state.params || SMFT_PARAMS;
    const out = [];
    for(const b of tailBars){
      const tr = trueRange(b.high, b.low, state.prevClose);
      state.atrRma = rmaNext(state.atrRma, tr, p.atrLen);
      const atrPct = (state.atrRma / (b.close || 1)) * 100;
      const alpha = smftAlpha(atrPct, p);

      if(state.oP == null){ state.oP=b.open; state.hP=b.high; state.lP=b.low; state.cP2=b.close; }
      else{
        state.oP  = state.oP  + alpha * (b.open  - state.oP);
        state.hP  = state.hP  + alpha * (b.high  - state.hP);
        state.lP  = state.lP  + alpha * (b.low   - state.lP);
        state.cP2 = state.cP2 + alpha * (b.close - state.cP2);
      }
      const prevCloseSmft = out.length ? out[out.length - 1].close : state.cP2;
      const rising = state.cP2 > prevCloseSmft;

      const pt = { time:b.time, open:state.oP, high:state.hP, low:state.lP, close:state.cP2, color: rising ? COLORS.up : COLORS.down };
      out.push(pt);
      outArrRef && outArrRef.push(pt);
      atrPctArrRef && atrPctArrRef.push(atrPct);
      state.prevClose = b.close;
    }
    return out;
  }

  // ───────────────────────── SMFT Δ Oscillator (hist + adaptive hysteresis) ─────────────────────────
  const OSC_PARAMS = { k: 0.34, bandLen: 34, sigDiv: 3.0 }; // tune to your Pine values

  function buildOsc(bars, smftBars, atrPctArr){
    let prevClose = null;
    let osc = 0, sig = 0, amp = 0;
    const histArr=[], upperArr=[], lowerArr=[], zeroArr=[];
    const markers=[];
    let prevHist=null, prevUpper=null, prevLower=null;

    for(let i=0;i<bars.length;i++){
      const b = bars[i];
      const s = smftBars[i].close;
      const delta = i ? (s - smftBars[i-1].close) : 0;

      // Use same alpha that drove SMFT (reproducible “memory”)
      const atrPct = atrPctArr[i] ?? 0;
      const alpha  = smftAlpha(atrPct, SMFT_PARAMS);

      // Oscillator core (Δ with variable-alpha EMA + slower signal)
      osc = osc + alpha * (delta - osc);
      sig = sig + (alpha / OSC_PARAMS.sigDiv) * (osc - sig);
      const hist = osc - sig;

      // Adaptive hysteresis from running |hist| (RMA)
      amp = rmaNext(amp, Math.abs(hist), OSC_PARAMS.bandLen);
      const band = OSC_PARAMS.k * amp;
      const up = +band, lo = -band;

      const t = b.time;
      histArr.push({ time:t, value:hist, color: hist >= 0 ? COLORS.up : COLORS.down });
      upperArr.push({ time:t, value:up });
      lowerArr.push({ time:t, value:lo });
      zeroArr.push({ time:t, value:0 });

      if(prevHist!=null){
        const crossedUp   = prevHist <= (prevUpper ?? up) && hist > up;
        const crossedDown = prevHist >= (prevLower ?? lo) && hist < lo;
        if(crossedUp){
          markers.push({ time:t, position:'belowBar', color: COLORS.up, shape:'arrowUp', text:'BUY' });
        }else if(crossedDown){
          markers.push({ time:t, position:'aboveBar', color: COLORS.down, shape:'arrowDown', text:'SELL' });
        }
      }
      prevHist = hist; prevUpper = up; prevLower = lo;
      prevClose = b.close;
    }

    return {
      histArr, upperArr, lowerArr, zeroArr,
      state: { prevClose, osc, sig, amp, prevHist, prevUpper, prevLower },
      markers
    };
  }

  function oscStep(state, tailBars, tailSmft, tailAtrPct){
    const histUpd=[], upUpd=[], loUpd=[], zeroUpd=[], markers=[];
    for(let i=0;i<tailBars.length;i++){
      const b = tailBars[i];
      const s = tailSmft[i].close;
      const delta = i ? (s - tailSmft[i-1].close) : (s - s); // 0 for first

      const alpha = smftAlpha(tailAtrPct[i] ?? 0, SMFT_PARAMS);
      state.osc = state.osc + alpha * (delta - state.osc);
      state.sig = state.sig + (alpha / OSC_PARAMS.sigDiv) * (state.osc - state.sig);
      const hist = state.osc - state.sig;

      state.amp = rmaNext(state.amp, Math.abs(hist), OSC_PARAMS.bandLen);
      const band = OSC_PARAMS.k * state.amp;
      const up = +band, lo = -band;

      const t = b.time;
      histUpd.push({ time:t, value:hist, color: hist >= 0 ? COLORS.up : COLORS.down });
      upUpd.push({ time:t, value:up });
      loUpd.push({ time:t, value:lo });
      zeroUpd.push({ time:t, value:0 });

      if(state.prevHist!=null){
        const crossedUp   = state.prevHist <= (state.prevUpper ?? up) && hist > up;
        const crossedDown = state.prevHist >= (state.prevLower ?? lo) && hist < lo;
        if(crossedUp){
          markers.push({ time:t, position:'belowBar', color: COLORS.up, shape:'arrowUp', text:'BUY' });
        }else if(crossedDown){
          markers.push({ time:t, position:'aboveBar', color: COLORS.down, shape:'arrowDown', text:'SELL' });
        }
      }
      state.prevHist=hist; state.prevUpper=up; state.prevLower=lo;
      state.prevClose = b.close;
    }
    return { histUpd, upUpd, loUpd, zeroUpd, markers };
  }

  // ───────────────────────── TwelveData fetchers ─────────────────────────
  async function fetchTDSeries(symbol, interval, size=1000){
    if(!TD_KEY){ throw new Error('Missing TwelveData API key. Add data-td-key on #cycla-chart-widget.'); }
    const url = new URL('https://api.twelvedata.com/time_series');
    url.searchParams.set('symbol', symbol);
    url.searchParams.set('interval', interval);
    url.searchParams.set('outputsize', String(size));
    url.searchParams.set('timezone', 'UTC');
    url.searchParams.set('format', 'JSON');
    url.searchParams.set('order', 'ASC');
    url.searchParams.set('apikey', TD_KEY);

    const res = await fetch(url.toString());
    const data = await res.json();
    if(data.status === 'error' || !data.values){
      const msg = data.message || 'TwelveData error';
      throw new Error(msg);
    }
    return data.values.map(v => ({
      time:  toEpoch(v.datetime),
      open:  parseFloat(v.open),
      high:  parseFloat(v.high),
      low:   parseFloat(v.low),
      close: parseFloat(v.close),
    }));
  }

  async function getBars(symbol, tfKey, wantBars=600){
    const spec = TF[tfKey];
    if(!spec) throw new Error('Unsupported TF: '+tfKey);

    if(spec.kind === 'native'){
      const native = await fetchTDSeries(
        symbol,
        spec.td,
        clamp(Math.round(wantBars * 1.2), 300, TD_LIMIT)
      );
      return native;
    }else{
      const mult = spec.mult;
      const baseSize = Math.min(Math.round(wantBars * mult * 1.3), TD_LIMIT);
      const base = await fetchTDSeries(symbol, '1min', baseSize);
      const out  = resampleOHLC(base, mult*60);
      return out.slice(-Math.min(wantBars, out.length));
    }
  }

  async function getTail(symbol, tfKey){
    const spec = TF[tfKey];
    if(spec.kind === 'native'){
      const tail = await fetchTDSeries(symbol, spec.td, Math.min(3, TD_LIMIT));
      return tail.slice(-3);
    }else{
      const baseTail = await fetchTDSeries(symbol, '1min', Math.min(spec.mult * 6, TD_LIMIT));
      return resampleOHLC(baseTail, spec.mult*60).slice(-2);
    }
  }

  // ───────────────────────── Chart bootstrap (two panes) ─────────────────────────
  const LC = window.LightweightCharts;
  const PRICE_CONTAINER = ROOT.querySelector('#lc-container');
  const OSC_CONTAINER   = ROOT.querySelector('#osc-container');

  if(!LC || !LC.createChart){
    PRICE_CONTAINER.innerHTML = '<div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;color:#1b2a4a;font-weight:700;">Chart library failed to load.</div>';
    return;
  }

  const baseOptions = (height)=>({
    width:  PRICE_CONTAINER.clientWidth,
    height,
    layout: { background: { type:'solid', color:'transparent' }, textColor: COLORS.text, fontSize: 12 },
    rightPriceScale: { borderVisible:false },
    timeScale: {
      borderVisible:false,
      timeVisible:true,
      secondsVisible:false,
      tickMarkFormatter,
    },
    localization: { locale: LOCALE, timeFormatter: (t)=>crosshairTimeFormatter(t, '1m') },
    grid: { vertLines: { color: COLORS.grid }, horzLines: { color: COLORS.grid } },
    crosshair: {
      mode: 0,
      vertLine: { labelVisible:false },
      horzLine: { labelVisible:true }
    },
  });

  const chart    = LC.createChart(PRICE_CONTAINER, baseOptions(PRICE_CONTAINER.clientHeight));
  const oscChart = LC.createChart(OSC_CONTAINER,   baseOptions(OSC_CONTAINER.clientHeight));

  const series = chart.addCandlestickSeries({
    upColor: COLORS.up, downColor: COLORS.down,
    borderUpColor: COLORS.upBorder, borderDownColor: COLORS.downBorder,
    wickUpColor: COLORS.wick, wickDownColor: COLORS.wick,
  });

  // Oscillator: histogram + bands + zero
  const oscHist   = oscChart.addHistogramSeries({ priceFormat:{ type:'price', precision:6, minMove:0.000001 }, base:0 });
  const oscUpper  = oscChart.addLineSeries({ color: COLORS.band, lineWidth:1, priceFormat:{ type:'price', precision:6, minMove:0.000001 } });
  const oscLower  = oscChart.addLineSeries({ color: COLORS.bandLo, lineWidth:1, priceFormat:{ type:'price', precision:6, minMove:0.000001 } });
  const oscZero   = oscChart.addLineSeries({ color: COLORS.zero, lineWidth:1, priceFormat:{ type:'price', precision:6, minMove:0.000001 } });

  // Resize observers keep exact fit
  new ResizeObserver(() => {
    chart.applyOptions({ width: PRICE_CONTAINER.clientWidth, height: PRICE_CONTAINER.clientHeight });
  }).observe(PRICE_CONTAINER);
  new ResizeObserver(() => {
    oscChart.applyOptions({ width: OSC_CONTAINER.clientWidth, height: OSC_CONTAINER.clientHeight });
  }).observe(OSC_CONTAINER);

  // Wick toggle
  let wicksOn = true;
  W_BTN.addEventListener('click', ()=>{
    wicksOn = !wicksOn;
    series.applyOptions({
      wickUpColor: wicksOn ? COLORS.wick : 'transparent',
      wickDownColor: wicksOn ? COLORS.wick : 'transparent',
    });
  });

  // Crosshair time tooltip (price pane)
  chart.subscribeCrosshairMove(param=>{
    if(!param || !param.point || param.time === undefined){
      TIP.classList.remove('cp-tip--show');
      TIP_OSC.classList.remove('cp-tip--show');
      return;
    }
    const x = param.point.x;
    const pad = 8;
    const clampX = (container, xx)=> Math.max(pad, Math.min(container.clientWidth - pad, xx));

    const label = crosshairTimeFormatter(param.time, current.tf);
    TIP.textContent = label;
    TIP.style.left = clampX(PRICE_CONTAINER, x) + 'px';
    TIP.style.bottom = '8px';
    TIP.style.top = '';
    TIP.classList.add('cp-tip--show');

    TIP_OSC.textContent = label;
    TIP_OSC.style.left = clampX(OSC_CONTAINER, x) + 'px';
    TIP_OSC.classList.add('cp-tip--show');

    // Attempt programmatic crosshair sync if available (v4+)
    try{
      const sd = param.seriesData?.get?.(series);
      const priceForTime = sd?.close ?? 0;
      if(typeof oscHist.setCrosshairPosition === 'function'){
        const sdOsc = param.seriesData?.get?.(oscHist);
        const v = sdOsc?.value ?? 0;
        oscHist.setCrosshairPosition(v, param.time);
      }
      if(typeof series.setCrosshairPosition === 'function' && typeof oscHist.priceScale === 'function'){
        // no-op branch; left for future lib versions
      }
    }catch(e){}
  });
  PRICE_CONTAINER.addEventListener('mouseleave', ()=>{
    TIP.classList.remove('cp-tip--show');
    TIP_OSC.classList.remove('cp-tip--show');
  });

  // Scroll/zoom sync (bidirectional)
  let syncing = false;
  function linkScales(a, b){
    a.timeScale().subscribeVisibleLogicalRangeChange(range=>{
      if(syncing || !range) return;
      syncing = true;
      try{ b.timeScale().setVisibleLogicalRange(range); } finally { syncing = false; }
    });
  }
  linkScales(chart, oscChart);
  linkScales(oscChart, chart);

  // ───────────────────────── Load symbol + TF ─────────────────────────
  let current = {
    symbol: normalizeSymbol(DEFAULT_SYMBOL),
    tf:'1m',
    poll:null,
    lastTime:0,
    smftState:null,
    oscState:null,
    markers:[]
  };

  function applyTfLocalization(tf){
    const base = { timeVisible: !(tf === '1D' || tf === '1M'), secondsVisible: false };
    chart.applyOptions({
      timeScale: base,
      localization: { locale: LOCALE, timeFormatter: (t)=>crosshairTimeFormatter(t, tf) }
    });
    oscChart.applyOptions({
      timeScale: base,
      localization: { locale: LOCALE, timeFormatter: (t)=>crosshairTimeFormatter(t, tf) }
    });
  }

  async function load(symbolInput, tfInput){
    try{
      const symbol = normalizeSymbol(symbolInput || current.symbol);
      const tf     = tfInput || current.tf;
      if(current.poll){ clearInterval(current.poll); current.poll = null; }

      TF_BTN.textContent = tf;
      INFO.sym.textContent  = symbol.replace('/', '-');
      INFO.name.textContent = '—';
      INFO.last.textContent = 'Last: —';

      applyTfLocalization(tf);

      // Bars + SMFT candles
      const bars = await getBars(symbol, tf, 600);
      const smftFull = buildSMFT(bars, SMFT_PARAMS);
      series.setData(smftFull.bars);

      // Oscillator + bands + signals
      const oscFull = buildOsc(bars, smftFull.bars, smftFull.atrPctArr);
      oscHist.setData(oscFull.histArr);
      oscUpper.setData(oscFull.upperArr);
      oscLower.setData(oscFull.lowerArr);
      oscZero.setData(oscFull.zeroArr);
      current.markers = oscFull.markers;
      series.setMarkers(current.markers);

      current.lastTime   = bars.length ? bars[bars.length-1].time : 0;
      current.smftState  = smftFull.state;
      current.oscState   = oscFull.state;

      chart.timeScale().fitContent();
      oscChart.timeScale().fitContent();

      // Instrument meta (optional)
      try{
        const qURL = new URL('https://api.twelvedata.com/quote');
        qURL.searchParams.set('symbol', symbol);
        qURL.searchParams.set('apikey', TD_KEY);
        const q = await fetch(qURL).then(r=>r.json());
        if(q && q.name){ INFO.name.textContent = q.name; }
        if(q && q.close){ INFO.last.textContent = 'Last: ' + Number(q.close).toFixed(2); }
      }catch(e){ /* non-fatal */ }

      // Start breathing poll (5s intraday, 15s higher TFs)
      const periodMs = (tf === '1H' || tf === '1D' || tf === '1M') ? 15000 : 5000;
      current.poll = setInterval(async ()=>{
        try{
          const tailBars = await getTail(symbol, tf);
          if(!tailBars.length) return;

          // Extend SMFT & ATR% series in-place to keep osc coherent
          const smftTail = smftStep(current.smftState, tailBars, null, null); // we’ll recompute ATR% for osc below

          // Recompute ATR% for tail (same ATR len)
          const tailAtrPct = [];
          let atrRma = current.smftState.atrRma;
          let prevClose = current.smftState.prevClose;
          for(const b of tailBars){
            const tr = trueRange(b.high,b.low,prevClose);
            atrRma = rmaNext(atrRma, tr, SMFT_PARAMS.atrLen);
            tailAtrPct.push((atrRma/(b.close||1))*100);
            prevClose = b.close;
          }

          // Update price series
          for(const bar of smftTail){
            if(bar.time >= current.lastTime){
              series.update(bar);
              current.lastTime = bar.time;
            }
          }

          // Update oscillator + bands + markers
          const { histUpd, upUpd, loUpd, zeroUpd, markers } = oscStep(current.oscState, tailBars, smftTail, tailAtrPct);
          histUpd.forEach(pt=>oscHist.update(pt));
          upUpd.forEach(pt=>oscUpper.update(pt));
          loUpd.forEach(pt=>oscLower.update(pt));
          zeroUpd.forEach(pt=>oscZero.update(pt));

          if(markers.length){
            current.markers = (current.markers || []).concat(markers);
            // Keep markers bounded (avoid unbounded growth on very long sessions)
            if(current.markers.length > 1200) current.markers = current.markers.slice(-800);
            series.setMarkers(current.markers);
          }

          const lastRaw = tailBars[tailBars.length-1];
          INFO.last.textContent = 'Last: ' + Number(lastRaw.close).toFixed(2);
        }catch(e){}
      }, periodMs);

      current.symbol = symbol;
      current.tf = tf;

      // Search focus UX
      SEARCH.value = symbol.replace('/', '-');

    }catch(err){
      console.error(err);
    }
  }

  // Search: Enter to load
  SEARCH.addEventListener('keydown', (e)=>{
    if(e.key === 'Enter'){
      const v = (SEARCH.value || '').trim();
      if(v) load(v, current.tf);
    }
  });

  // TF menu toggle + selection
  TF_BTN.addEventListener('click', ()=> TF_MENU.classList.toggle('cp-dd--hidden'));
  TF_MENU.addEventListener('mouseleave', ()=> TF_MENU.classList.add('cp-dd--hidden'));
  document.addEventListener('click', (e)=>{
    if(!TF_MENU.contains(e.target) && e.target !== TF_BTN){
      TF_MENU.classList.add('cp-dd--hidden');
    }
  });
  TF_MENU.querySelectorAll('button').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const tf = btn.getAttribute('data-tf');
      TF_MENU.classList.add('cp-dd--hidden');
      load(current.symbol, tf);
    });
  });

  // Bootstrap
  load(DEFAULT_SYMBOL, '1m');

})();
</script>
