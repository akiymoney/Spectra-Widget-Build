//@version=6
strategy("1m Strategy", shorttitle="1m Strategy", overlay=false, precision=2, fill_orders_on_standard_ohlc=true, pyramiding=0)

// ── SMFT parameters
grpMem   = "Spectral Memory (SMFT)"
xiCosmic = input.float(3.0, "ξ (Cosmic memory cap)", minval=1.0, step=0.25, group=grpMem)
eSatPct  = input.float(8.0, "E_sat% (ATR% compress)", minval=0.1, step=0.1, group=grpMem)
gamma    = input.float(8.0, "γ (nonlinearity)", minval=0.1, step=0.1, group=grpMem)
atrLen   = input.int(5, "ATR length (RMA)", minval=1, group=grpMem)

// ── Oscillator controls
grpOsc = "Oscillator"
len    = input.int(3, "Length", minval=1, group=grpOsc)
tfIn   = input.timeframe("", "Timeframe (blank = chart)", group=grpOsc)
bandPct= input.float(0.013, "Hysteresis band %", minval=0.0, step=0.1, group=grpOsc)

// ── Helpers
tfOrChart(tf) => tf == "" ? timeframe.period : tf

f_smft_close(_atrLen, _xi, _eSat, _g) =>
    float atr    = ta.atr(_atrLen)
    float atrPct = 100.0 * atr / math.max(1e-9, close)
    float xiMem  = _xi / (1.0 + math.pow(atrPct / _eSat, _g))
    float xiC    = math.max(1.0, xiMem)
    float a      = 2.0 / (xiC + 1.0)
    var float cP = na
    cP := na(cP[1]) ? close : (cP[1] + a * (close - cP[1]))
    cP

// ── SMFT close on chosen timeframe (no lookahead)
smftClose = request.security(syminfo.tickerid, tfOrChart(tfIn), f_smft_close(atrLen, xiCosmic, eSatPct, gamma), barmerge.gaps_off, barmerge.lookahead_off)

// ── Δ oscillator (percent from EMA)
base   = ta.ema(smftClose, len)
oscPct = 100.0 * (smftClose - base) / math.max(1e-9, base)

// ── Zero + hysteresis bands
hline(0, "0", color=color.new(color.gray, 70))
hline(+bandPct, "Upper band", color=color.new(color.rgb(67,216,219), 70))
hline(-bandPct, "Lower band", color=color.new(color.rgb(132,65,220), 70))

// ── Columns: teal above 0, purple below 0
colTeal   = color.rgb(67, 216, 219)
colPurple = color.rgb(132, 65, 220)
col       = oscPct >= 0 ? colTeal : colPurple
plot(oscPct, "SMFT Δ%", style=plot.style_area, color=col)

// ── Hysteresis-cross labels (with state to avoid duplicates)
crossUp   = ta.crossover(oscPct, +bandPct)
crossDown = ta.crossunder(oscPct, -bandPct)

var int state = 0
prev = nz(state[1], 0)
buy  = crossUp   and prev != 1
sell = crossDown and prev != -1
state := buy ? 1 : sell ? -1 : prev

plotshape(buy,  title="BUY",  style=shape.labelup,   location=location.bottom, color=color.new(colTeal, 0),   text="BUY",  textcolor=color.white, size=size.tiny)
plotshape(sell, title="SELL", style=shape.labeldown, location=location.top,    color=color.new(colPurple, 0), text="SELL", textcolor=color.white, size=size.tiny)

// ── Strategy entries (TV model mapping)
if buy
    strategy.entry("Long", strategy.long)
if sell
    strategy.entry("Short", strategy.short)
