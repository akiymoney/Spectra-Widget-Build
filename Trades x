<!-- CYCLA • Trades Panel (233x523) • P/L • Watchlist • Active Trades • Info banner • AUTO/BUY/SELL/KS -->
<div id="cycla-trades-center" style="--block-h:523px;">
  <div id="cycla-trades-widget" role="region" aria-label="CYCLA Trades Panel">
    <div class="tp-label" aria-hidden="true">Cycla Trades</div>

    <!-- Top HUD: P/L (233x89) -->
    <section class="tp-hud tp-pl" aria-label="P/L">
      <header class="tp-hdr">P/L</header>
      <div class="tp-pl-body" id="tp-pl-body" aria-live="polite" role="status">—</div>
    </section>

    <!-- Second HUD: Watchlist (233x144) -->
    <section class="tp-hud tp-watch" aria-labelledby="hdr-watch">
      <header class="tp-hdr" id="hdr-watch">
        Watchlist
        <button id="tp-watch-clear" class="tp-ico-btn" title="Clear Watchlist" aria-label="Clear Watchlist">✕</button>
      </header>
      <div class="tp-list" id="tp-watch-list" role="listbox" aria-label="Watchlist"></div>
    </section>

    <!-- Third HUD: Active Trades (233x144) -->
    <section class="tp-hud tp-active" aria-labelledby="hdr-active">
      <header class="tp-hdr" id="hdr-active">Active Trades</header>
      <div class="tp-list" id="tp-active-list" role="listbox" aria-label="Active Trades"></div>
    </section>

    <!-- Fourth HUD: Info banner (233x34) -->
    <section class="tp-hud tp-info" aria-label="Info">
      <div class="tp-info-marquee" id="tp-info-banner" aria-live="polite">Trades ECU: ready.</div>
    </section>

    <!-- Bottom row: AUTO / BUY / SELL / KS (each 34x34) -->
    <div class="tp-toolbar" role="toolbar" aria-label="Trade controls">
      <button id="tp-auto" class="tp-btn" title="AUTO" aria-pressed="false">🤖</button>
      <button id="tp-buy"  class="tp-btn" title="BUY">B</button>
      <button id="tp-sell" class="tp-btn" title="SELL">S</button>
      <button id="tp-ks"   class="tp-btn" title="Kill Switch">⏻</button>
    </div>
  </div>
</div>

<style>
  #cycla-trades-center *{ box-sizing:border-box; }
  #cycla-trades-center{
    width:100%; height:var(--block-h,523px);
    display:flex; align-items:center; justify-content:center;
    margin:0 auto; padding:0; position:relative;
  }
  /* Root 233×523: glassy shell to match Screener */
  #cycla-trades-widget{
    position:relative;
    width:233px; height:523px; margin:0 auto;
    border-radius:12px; border:1px solid rgba(10,20,40,.12);
    box-shadow:0 18px 55px rgba(8,16,40,.12), 0 2px 10px rgba(8,16,40,.08);
    background:linear-gradient(180deg,#f6f9ff 0%,#eef6ff 100%);
    font:12px/1.25 system-ui, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    color:#0b1220; overflow:hidden;
  }
  .tp-label{ position:absolute; top:6px; left:8px; font-weight:700; font-size:11px; color:#3b4a6b; opacity:.55; pointer-events:none; }

  /* HUD shells */
  .tp-hud{ position:absolute; left:6px; right:6px; border-radius:12px; border:1px solid rgba(10,20,40,.12); overflow:hidden; background:#fff; }
  .tp-pl    { top:  6px; height: 89px; background:linear-gradient(180deg,#dceeff 0%, #cbe0fa 100%); }
  .tp-watch { top: 97px; height:144px; background:linear-gradient(180deg,#e7f6ef 0%, #daf3e6 100%); }
  .tp-active{ top:245px; height:144px; background:linear-gradient(180deg,#f5f3ff 0%, #ece9ff 100%); }
  .tp-info  { top:393px; height: 34px; display:flex; align-items:center; justify-content:center;
              background:rgba(255,255,255,.78); }

  .tp-hdr{
    height:24px; display:flex; align-items:center; justify-content:flex-start;
    gap:6px; padding:0 8px; font-weight:800; color:#33415e; letter-spacing:.2px;
    background:rgba(255,255,255,.72); border-bottom:1px solid rgba(10,20,40,.10);
  }
  .tp-ico-btn{
    margin-left:auto; width:13px; height:13px; min-width:13px; min-height:13px;
    border-radius:4px; border:1px solid rgba(10,20,40,.18); background:#fff; font-size:10px;
    display:flex; align-items:center; justify-content:center; line-height:11px; cursor:pointer;
  }
  .tp-pl-body{ padding:8px; font-weight:800; color:#1b2a4a; }

  .tp-list{ height:calc(100% - 24px); padding:6px; overflow:auto; }
  .tp-row{
    display:grid; grid-template-columns:1fr auto; gap:6px; align-items:center;
    padding:6px; margin-bottom:6px; border-radius:8px; background:#fff;
    border:1px solid rgba(10,20,40,.12); font-weight:800; color:#1b2a4a;
  }
  .tp-row .tf{ font-size:10px; font-weight:800; opacity:.8; padding:2px 6px; border-radius:999px; border:1px solid rgba(10,20,40,.12); }
  .tp-row .sym{ font-weight:900; }
  .tp-row .rm{ width:18px; height:18px; border-radius:6px; border:1px solid rgba(10,20,40,.14); background:#f8fafc; font-weight:800; cursor:pointer; }

  /* Info banner scrolling */
  .tp-info-marquee{ width:100%; padding:0 8px; font-weight:800; color:#33415e; white-space:nowrap; overflow:hidden; }
  .tp-info-marquee{ animation: tp-marq 16s linear infinite; }
  @keyframes tp-marq{ from{ transform:translateX(0);} to{ transform:translateX(-100%);} }

  /* Bottom toolbar (34px tall), pinned */
  .tp-toolbar{
    position:absolute; bottom:6px; left:6px; right:6px; height:34px;
    display:flex; gap:6px; align-items:center; justify-content:space-between;
    background:#fff; border:1px solid rgba(10,20,40,.14); border-radius:10px; padding:0 6px;
  }
  .tp-btn{
    width:34px; height:34px; min-width:34px; min-height:34px; cursor:pointer;
    border-radius:10px; border:1px solid rgba(10,20,40,.14); background:rgba(255,255,255,.95);
    box-shadow:0 13px 21px rgba(8,16,40,.18); font-weight:800; display:flex; align-items:center; justify-content:center;
  }
</style>

<script>
(()=>{
  const ROOT = document.getElementById('cycla-trades-widget');

  // ───────────────────────── config ─────────────────────────
  // IMPORTANT: If this page is served over HTTPS, RELAY_BASE must also be HTTPS.
  // e.g., "https://spectra-relay.onrender.com"
  const RELAY_BASE    = (window.CYCLA && window.CYCLA.RELAY_BASE) || "https://spectra-trade-bot.onrender.com";
  const STEP_SECONDS  = 5;
  const BUY_QTY_MODE  = "notional";
  const NOTIONAL_USD  = 3; // your value
  const POLL_MS       = 1500;

  // ───────────────────────── shared bus ─────────────────────
  window.CYCLA = window.CYCLA || {};
  window.CYCLA.bus = window.CYCLA.bus || new EventTarget();

  // ───────────────────────── DOM refs ───────────────────────
  const PL_BOX   = document.getElementById('tp-pl-body');
  const W_LIST   = document.getElementById('tp-watch-list');
  const A_LIST   = document.getElementById('tp-active-list');
  const INFO_BNR = document.getElementById('tp-info-banner');

  const BTN_AUTO = document.getElementById('tp-auto');
  const BTN_BUY  = document.getElementById('tp-buy');
  const BTN_SELL = document.getElementById('tp-sell');
  const BTN_KS   = document.getElementById('tp-ks');
  const BTN_WCLR = document.getElementById('tp-watch-clear');

  // ───────────────────────── local state ─────────────────────
  let AUTO = false;
  const watch  = new Map();
  const active = new Map();

  let chartSymbolUI = "BTCUSD";
  let chartTF = "1m";
  let lastChartPrice = null;

  const sameOrigin = (() => {
    try { return new URL(RELAY_BASE, location.href).origin === location.origin; }
    catch { return false; }
  })();

  // If you don't need cookies, omit credentials to simplify CORS.
  const COMMON_FETCH = { mode: sameOrigin ? 'same-origin' : 'cors', credentials: 'omit' };

  const uiToRelay = (s) => {
    const S = String(s||"").trim().toUpperCase();
    if (!S) return "";
    return S.includes("-") ? S : (S.endsWith("USD") ? (S.slice(0,-3) + "-USD") : S.replace("/", "-"));
  };
  const prettyUsd = (n) => (Number.isFinite(n) ? `$${n.toLocaleString(undefined,{maximumFractionDigits:2})}` : "—");

  function ecu(level='ok', code='TW-OK-100', msg=''){
    INFO_BNR.textContent = `ECU ${level.toUpperCase()}: [${code}] ${msg}`;
    window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:ecu', { detail: { level, msg: `[${code}] ${msg}` }}));
  }

  function rowFor({ sym, tf }, canRemove=true){
    const row = document.createElement('div');
    row.className = 'tp-row';
    const left = document.createElement('div');
    const right = document.createElement('div');
    const symEl = document.createElement('span'); symEl.className='sym'; symEl.textContent = sym;
    const tfEl  = document.createElement('span'); tfEl.className='tf';  tfEl.textContent  = tf;
    left.appendChild(symEl); left.appendChild(document.createTextNode(' ')); left.appendChild(tfEl);
    if (canRemove){
      const rm = document.createElement('button');
      rm.className = 'rm'; rm.title = 'Remove'; rm.textContent = '–';
      rm.addEventListener('click', ()=>{ watch.delete(sym); renderWatch(); ecu('warn','TW-WARN-210',`Removed ${sym} from Watchlist.`); });
      right.appendChild(rm);
    }
    row.appendChild(left); row.appendChild(right);
    return row;
  }
  function renderWatch(){ W_LIST.innerHTML = ''; for(const v of watch.values()) W_LIST.appendChild(rowFor(v,true)); }
  function renderActive(){ A_LIST.innerHTML = ''; for(const v of active.values()) A_LIST.appendChild(rowFor(v,false)); }

  // ───────────────────────── chart wiring ────────────────────
  window.CYCLA.bus.addEventListener('cycla:chart:context', (e)=>{
    const d = (e && e.detail) || {};
    if (d.symbol) chartSymbolUI = String(d.symbol).toUpperCase().replace(/[^\w-]/g,'');
    if (d.tf) chartTF = String(d.tf);
    if (Number.isFinite(Number(d.last))) lastChartPrice = Number(d.last);
  });
  window.CYCLA.bus.addEventListener('cycla:watchlist:add', (e)=>{
    const { symbol='', tf='1m' } = (e && e.detail) || {};
    if (!symbol) { ecu('err','TW-ERR-400','Empty symbol from chart.'); return; }
    const sym = String(symbol).toUpperCase().replace(/[^\w]/g,'');
    watch.set(sym, { sym, tf }); renderWatch();
    ecu('ok','TW-OK-102', `Added ${sym} (${tf}) to Watchlist.`);
  });

  // ───────────────────────── relay I/O ───────────────────────
  async function jget(path){
    const url = `${RELAY_BASE}${path}`;
    let r;
    try {
      r = await fetch(url, { ...COMMON_FETCH, method:'GET', headers:{ 'Accept':'application/json' } });
    } catch (e) {
      throw netFail(url, e);
    }
    if (!r.ok) throw httpFail(url, r);
    return r.json();
  }
  async function jpost(path, body){
    const url = `${RELAY_BASE}${path}`;
    let r, j;
    try {
      r = await fetch(url, {
        ...COMMON_FETCH,
        method:'POST',
        headers:{ 'Content-Type':'application/json', 'Accept':'application/json' },
        body: JSON.stringify(body)
      });
      j = await r.json().catch(()=> ({}));
    } catch (e) {
      throw netFail(url, e);
    }
    if (!r.ok) throw new Error(`${j.error || j.backend_status || r.statusText || ('HTTP '+r.status)}`);
    return j;
  }
  function netFail(url, err){
    const httpsPage = location.protocol === 'https:';
    const httpRelay = /^http:/.test(url);
    if (httpsPage && httpRelay) return new Error('mixed_content: Page is HTTPS but RELAY_BASE is HTTP. Use HTTPS relay.');
    return new Error(`network_error: ${err && err.message ? err.message : 'fetch failed'}`);
  }
  function httpFail(url, r){
    // If it’s a 404/405 on POST, it’s almost certainly wrong path or CORS preflight blocked server.
    if (r.status === 404) return new Error('path_not_found: check /order, /status routes.');
    if (r.status === 405) return new Error('method_not_allowed: server not accepting POST (or OPTIONS).');
    return new Error(`HTTP_${r.status}: ${r.statusText}`);
  }

  async function resolvePxFor(side, relaySym, qtyHint){
    if (Number.isFinite(lastChartPrice) && lastChartPrice > 0) return lastChartPrice;
    const q = qtyHint && Number.isFinite(Number(qtyHint)) ? `&qty=${encodeURIComponent(qtyHint)}` : '';
    const book = await jget(`/dbg/book?symbol=${encodeURIComponent(relaySym)}${q}`);
    const px = side === 'BUY' ? Number(book.est_ask_for_qty || book.ask) : Number(book.est_bid_for_qty || book.bid);
    if (!Number.isFinite(px) || px <= 0) throw new Error('price_unavailable');
    return px;
  }

  async function resolveBuyQtyFromNotional(relaySym, notionalUsd){
    const dbg = await jget(`/dbg/holdings?symbol=${encodeURIComponent(relaySym)}`);
    const step = Number(dbg.min_qty || 0);
    if (!Number.isFinite(step) || step <= 0) throw new Error('min_qty_unavailable');

    let ask = NaN;
    try{
      const b = await jget(`/dbg/book?symbol=${encodeURIComponent(relaySym)}`);
      ask = Number(b.est_ask_for_qty || b.ask || NaN);
    }catch{}
    if (!Number.isFinite(ask) || ask <= 0) {
      if (Number.isFinite(lastChartPrice) && lastChartPrice > 0) ask = lastChartPrice;
      else throw new Error('ask_unavailable');
    }

    const rawQ = notionalUsd / ask;
    let steps = Math.floor(rawQ / step);
    if (steps < 1) steps = 1;
    const qty = Number((steps * step).toFixed(12));
    if (!Number.isFinite(qty) || qty <= 0) throw new Error('qty_computation_failed');
    return qty;
  }

  async function resolveBuyQtyMin(relaySym){
    const dbg = await jget(`/dbg/holdings?symbol=${encodeURIComponent(relaySym)}`);
    const min = Number(dbg.min_qty || 0);
    if (!Number.isFinite(min) || min <= 0) throw new Error('min_qty_unavailable');
    return min;
  }

  async function placeOrder({ uiSym, side }){
    const relaySym = uiToRelay(uiSym);
    if (!relaySym) throw new Error('bad_symbol');

    let size;
    if (side === 'BUY'){
      size = (BUY_QTY_MODE === 'notional')
        ? await resolveBuyQtyFromNotional(relaySym, NOTIONAL_USD)
        : await resolveBuyQtyMin(relaySym);
    } else {
      size = "ALL";
    }

    const px = await resolvePxFor(side, relaySym, (side==='BUY'?size:undefined));
    const payload = { symbol: relaySym, side, price: px, size, seconds: STEP_SECONDS };

    const res = await jpost('/order', payload);
    const act = String(res?.backend_status || res?.result?.action || '');
    const filled = Number(res?.result?.filled || 0);
    const avgPx  = Number(res?.result?.avg_price || px);

    const key = uiSym.toUpperCase().replace(/[^\w]/g,'');
    if (!active.has(key)) { active.set(key, { sym:key, tf:chartTF }); renderActive(); }

    ecu(res.ok ? 'ok' : 'err', res.ok ? 'TW-OK-120' : 'TW-ERR-420',
        `${side} ${relaySym} • ${act} • qty=${filled || size} @ ~${avgPx}`);

    await refreshHudOnce(relaySym).catch(()=>{});
  }

  // ───────────────────────── HUD ─────────────────────────────
  async function refreshHudOnce(relaySym){
    const sym = relaySym || uiToRelay(chartSymbolUI);

    let bid=NaN, ask=NaN;
    try{
      const b = await jget(`/dbg/book?symbol=${encodeURIComponent(sym)}`);
      bid = Number(b.est_bid_for_qty || b.bid || NaN);
      ask = Number(b.est_ask_for_qty || b.ask || NaN);
    }catch{}

    let curQty = 0, minQty = 0, holdingsCount = 0;
    try{
      const h = await jget(`/dbg/holdings?symbol=${encodeURIComponent(sym)}`);
      minQty = Number(h.min_qty || 0);
      holdingsCount = Array.isArray(h.all_holdings) ? h.all_holdings.length : 0;
      const row = h.holding_row || {};
      curQty =
        Number(row.quantity_available_for_trading ?? row.available_asset_quantity ?? row.asset_quantity ?? row.total_quantity ?? row.quantity ?? 0) || 0;
    }catch{}

    const estBuyUsd  = NOTIONAL_USD;
    const estSellUsd = Number.isFinite(curQty) && Number.isFinite(bid) && curQty>0 && bid>0 ? (curQty*bid) : NaN;

    const l1 = `BUY: ${prettyUsd(estBuyUsd)}  •  SELL: ${prettyUsd(estSellUsd)}  •  SYM: ${sym}`;
    const l2 = `Holdings(${holdingsCount}) • ${sym.split('-')[0]} qty ${curQty} • Bid ${prettyUsd(bid)} • Ask ${prettyUsd(ask)} • Notional ${prettyUsd(NOTIONAL_USD)}`;

    PL_BOX.innerHTML = `<div>${l1}</div><div class="tp-info-marquee" style="margin-top:4px;">${l2}</div>`;
  }

  // ───────────────────────── controls ────────────────────────
  BTN_WCLR.addEventListener('click', ()=>{ watch.clear(); renderWatch(); ecu('warn','TW-WARN-211','Watchlist cleared.'); });

  BTN_AUTO.addEventListener('click', ()=>{
    AUTO = !AUTO; BTN_AUTO.setAttribute('aria-pressed', AUTO ? 'true' : 'false');
    if (AUTO){
      for (const [k, v] of watch.entries()) active.set(k, v);
      watch.clear(); renderWatch(); renderActive();
      window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:auto:start'));
      ecu('ok','TW-OK-101','AUTO started. Watchlist → Active.');
    }else{
      window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:auto:stop'));
      ecu('warn','TW-WARN-201','AUTO stopped.');
    }
  });

  BTN_BUY.addEventListener('click', async ()=>{
    try { await placeOrder({ uiSym: chartSymbolUI, side: 'BUY' }); }
    catch(err){ ecu('err','TW-ERR-421', `BUY failed: ${String(err.message||err)}`); }
  });

  BTN_SELL.addEventListener('click', async ()=>{
    try { await placeOrder({ uiSym: chartSymbolUI, side: 'SELL' }); }
    catch(err){ ecu('err','TW-ERR-422', `SELL failed: ${String(err.message||err)}`); }
  });

  BTN_KS.addEventListener('click', async ()=>{
    try { await jpost('/killswitch', {}); } catch {}
    AUTO = false; BTN_AUTO.setAttribute('aria-pressed','false');
    watch.clear(); active.clear(); renderWatch(); renderActive();
    PL_BOX.textContent = '—';
    window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:auto:stop'));
    ecu('err','TW-ERR-401','Kill Switch pressed: HUDs reset. (Server KS ON)');
  });

  // ───────────────────────── connectivity probe ──────────────
  async function probe(){
    const isHttpsPage = location.protocol === 'https:';
    if (isHttpsPage && /^http:/.test(RELAY_BASE)) {
      ecu('err','TW-ERR-601','Mixed content: set window.CYCLA.RELAY_BASE to your HTTPS relay URL.');
      return;
    }
    try{
      const j = await jget('/status');
      if (!j || j.ok !== true) ecu('warn','TW-WARN-602','Relay /status reachable but not ok:true.');
      else ecu('ok','TW-OK-600',`Relay OK • auto=${j.auto} • ks=${j.ks ?? false}`);
    }catch(e){
      ecu('err','TW-ERR-603',`Relay unreachable: ${e.message}`);
    }
  }

  // ───────────────────────── init ────────────────────────────
  probe();
  refreshHudOnce().catch(()=>{});
  setInterval(()=>{ refreshHudOnce().catch(()=>{}); }, POLL_MS);
  ecu('ok','TW-OK-100',`Trades widget ready. Relay wiring live (5s steps, BUY $${NOTIONAL_USD}).`);
})();
</script>
