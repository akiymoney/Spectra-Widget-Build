<!-- CYCLA • Trades Panel (233x523) • LED status • P/L HUD • AUTO • Manual BUY/SELL -->
<div id="cycla-trades-center" style="--block-h:523px;">
  <div id="cycla-trades-widget" role="region" aria-label="CYCLA Trades Panel">
    <div class="tp-label" aria-hidden="true"></div>

    <!-- Top HUD: P/L (233x89) -->
    <section class="tp-hud tp-pl" aria-label="P/L">
      <header class="tp-hdr">P/L</header>
      <div class="tp-pl-body" id="tp-pl-body" aria-live="polite" role="status">—</div>
    </section>

    <!-- Second HUD: Watchlist (233x144) -->
    <section class="tp-hud tp-watch" aria-labelledby="hdr-watch">
      <header class="tp-hdr" id="hdr-watch">Watchlist</header>
      <div class="tp-list" id="tp-watch" role="list" aria-labelledby="hdr-watch"></div>
    </section>

    <!-- Third HUD: Active Trades (233x144) -->
    <section class="tp-hud tp-active" aria-labelledby="hdr-active">
      <header class="tp-hdr" id="hdr-active">Active Trades</header>
      <div class="tp-list" id="tp-active" role="list" aria-labelledby="hdr-active"></div>
    </section>

    <!-- Bottom control cluster -->
    <div class="tp-row">
      <!-- AUTO toggle -->
      <button id="tp-auto-btn"
              class="tp-btn tp-auto-off"
              type="button"
              aria-controls="tp-watch tp-active"
              aria-pressed="false"
              data-state="off"
              title="AUTO trade on signal">
        AUTO
        <span class="tp-auto-led" aria-hidden="true"></span>
      </button>

      <!-- BUY button (manual limit-buy @ current price w/ 60s timeout) -->
      <button id="tp-buy-btn"
              class="tp-btn tp-btn--buy"
              type="button"
              title="Instant BUY (limit @ current price / best bid, cancel in 60s)">
        BUY
      </button>

      <!-- SELL button (manual limit-sell @ current price, cancel in 60s) -->
      <button id="tp-sell-btn"
              class="tp-btn tp-btn--sell"
              type="button"
              title="Instant SELL (limit @ current price / best ask, cancel in 60s)">
        SELL
      </button>

      <!-- KS button -->
      <button id="tp-ks"
              class="tp-btn tp-btn--danger tp-btn-ks"
              type="button"
              aria-controls="tp-active"
              title="Killswitch / Clear Active Trades">
        KS
      </button>
    </div>
  </div>
</div>

<style>
  :root{
    --tp-bg-top:#f6f9ff;
    --tp-bg-bot:#eef6ff;
    --tp-hud-bg:#ffffffc7;
    --tp-hud-brd:rgba(10,20,40,.12);
    --tp-hud-h:144px;
    --tp-hud-p:6px;
    --tp-hdr-h:23px;
  }

  #cycla-trades-center{
    width:233px;
    height:var(--block-h,523px);
    display:flex;
    align-items:flex-start;
    justify-content:center;
    margin:0 auto;
    padding:0;
  }

  /* Root 233×523 */
  #cycla-trades-widget{
    position:relative;
    width:233px;
    height:523px;
    margin:0 auto;
    border-radius:12px;
    border:1px solid rgba(10,20,40,.12);
    box-shadow:0 18px 55px rgba(8,16,40,.12), 0 2px 10px rgba(8,16,40,.08);
    background:linear-gradient(180deg,#f6f9ff 0%,#eef6ff 100%);
    font:12px/1.25 system-ui, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    color:#0b1220;
    overflow:hidden;
    padding:6px;
  }

  .tp-label{
    position:absolute;
    top:6px;
    left:8px;
    font-weight:700;
    font-size:11px;
    color:#3b4a6b;
    opacity:.55;
    pointer-events:none;
  }

  .tp-hud{
    position:relative;
    width:100%;
    margin:0 0 6px 0;
    padding:0;
    background:var(--tp-hud-bg);
    border:1px solid var(--tp-hud-brd);
    border-radius:10px;
    box-shadow:0 14px 32px rgba(8,16,40,.12);
    display:flex;
    flex-direction:column;
    min-height:var(--tp-hud-h);
    overflow:hidden;
  }

  .tp-pl{
    min-height:89px;
    background:linear-gradient(180deg,#fff 0%,#fff 60%,#f1f8ff 100%);
  }

  .tp-watch,
  .tp-active{
    min-height:144px;
    background:linear-gradient(180deg,#e7f6ef 0%, #daf3e6 100%);
  }

  .tp-hdr{
    flex:0 0 var(--tp-hdr-h);
    display:flex;
    align-items:center;
    padding:0 8px;
    font-size:11px;
    font-weight:800;
    color:#33415e;
    background:rgba(255,255,255,.78);
    border-bottom:1px solid rgba(10,20,40,.10);
  }

  .tp-pl-body{
    flex:1;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:800;
    font-size:16px;
    color:#1b2a4a;
    white-space:pre-line;
    text-align:center;
  }

  .tp-list{
    flex:1;
    padding:6px;
    overflow:auto;
    background:linear-gradient(180deg,#e7f6ef 0%, #daf3e6 100%);
  }

  /* Row layout:
     left col: symbol + chips
     right col: LED/status bubble  */
  .tp-row-item{
    display:grid;
    grid-template-columns:1fr auto;
    align-items:flex-start;
    justify-content:space-between;
    column-gap:8px;
    row-gap:2px;
    background:rgba(255,255,255,.6);
    border:1px solid rgba(10,20,40,.12);
    border-radius:8px;
    padding:4px 6px;
    margin-bottom:4px;
    box-shadow:0 10px 16px rgba(0,0,0,.07);
    cursor:pointer;
  }

  .tp-left{
    display:flex;
    flex-direction:column;
    min-width:0;
  }

  .tp-sym{
    font-size:12px;
    font-weight:800;
    color:#1b2a4a;
  }

  .tp-mini{
    display:flex;
    flex-wrap:wrap;
    gap:4px;
  }

  .tp-chip{
    border:1px solid rgba(10,20,40,.12);
    border-radius:999px;
    padding:2px 6px;
    font-weight:800;
    font-size:10px;
    background:#f8fafc;
    color:#33415e;
  }

  /* LED bubble in Active rows */
  .tp-led{
    width:8px;
    height:8px;
    border-radius:999px;
    box-shadow:0 0 3px rgba(0,0,0,.6);
  }

  .tp-led--idle{
    background:#6b7280;          /* gray / neutral */
  }
  .tp-led--pending{
    background:#fde047;          /* yellow */
    box-shadow:0 0 6px rgba(250,204,21,.9), 0 0 2px rgba(0,0,0,.4) inset;
    animation:tp-pulse .6s infinite alternate;
  }
  .tp-led--ok{
    background:#10b981;          /* green */
    box-shadow:0 0 6px rgba(16,185,129,.9), 0 0 2px rgba(0,0,0,.4) inset;
  }
  .tp-led--fail{
    background:#ef4444;          /* red */
    box-shadow:0 0 6px rgba(239,68,68,.9), 0 0 2px rgba(0,0,0,.4) inset;
  }

  @keyframes tp-pulse{
    0%   { opacity:.5; }
    100% { opacity:1; }
  }

  /* Bottom control cluster */
  .tp-row{
    position:absolute;
    bottom:6px;
    left:6px;
    right:6px;
    display:flex;
    flex-wrap:wrap;
    align-content:flex-start;
    gap:6px;
    justify-content:flex-start;
    align-items:flex-start;
    height:auto;
  }

  .tp-btn{
    width:55px;
    height:34px;
    border-radius:10px;
    border:1px solid rgba(10,20,40,.14);
    background:rgba(255,255,255,.95);
    box-shadow:0 13px 21px rgba(8,16,40,.18);
    font-weight:800;
    font-size:11px;
    color:#1b2a4a;
    line-height:1;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:0 6px;
    cursor:pointer;
    text-shadow:0 1px 0 rgba(255,255,255,.6);
  }

  .tp-btn-ks{
    background:radial-gradient(circle at 30% 30%, #fff 0%, #fee2e2 40%, #fecaca 100%);
    border-color:#dc2626;
    color:#7a0a0a;
  }

  .tp-btn--buy{
    border-color:#16a34a;
    color:#065f46;
  }

  .tp-btn--sell{
    border-color:#dc2626;
    color:#7a0a0a;
  }

  /* AUTO button states */
  .tp-auto-led{
    display:inline-block;
    width:6px;
    height:6px;
    border-radius:999px;
    margin-left:4px;
    box-shadow:0 0 2px rgba(0,0,0,.4);
  }

  /* AUTO off */
  .tp-auto-off{
    opacity:.75;
  }
  .tp-auto-off .tp-auto-led{
    background:#4b5563; /* gray */
    box-shadow:0 0 4px rgba(75,85,99,.8);
  }

  /* AUTO on / armed */
  .tp-auto-armed{
    border-color:#059669;
    color:#065f46;
    background:radial-gradient(circle at 30% 30%, #fff 0%, #d1fae5 40%, #a7f3d0 100%);
  }

  .tp-auto-armed .tp-auto-led{
    background:#16a34a;
    box-shadow:0 0 6px rgba(16,185,129,.9);
  }
</style>

<script>
(()=>{
  const ROOT = document.getElementById('cycla-trades-widget');

  // ------------------ CYCLA namespace prep ------------------
  window.CYCLA ??= {};
  window.CYCLA.bus = window.CYCLA.bus || new EventTarget();

  // --- GLOBAL helper so both manual + AUTO can grade fills the same way ---
  window.CYCLA.finalStatusFromOrderResponse = function finalStatusFromOrderResponse(json){
    // default pessimistic
    let st = 'fail';

    const act = json?.result?.action || '';
    const filled = Number(json?.result?.filled ?? 0);

    // success cases:
    // - any nonzero filled
    // - explicit successful actions from relay
    if (
      filled > 0 ||
      act === 'buy_limit_filled' ||
      act === 'sell_limit_filled' ||
      act === 'sell_timeout_market_remainder'
    ){
      st = 'ok';
    }

    return st;
  };

  // per-symbol TF freeze map (AUTO gating uses this; chart also keeps this synced)
  (window.CYCLA.tfBySymbol ||= Object.create(null));

  // relay base URL that /order posts to
  const RELAY = window?.CYCLA?.RELAY;
  const DAEMON = window?.CYCLA?.DAEMON;

  // ------------------ Element refs ------------------
  const WATCH      = ROOT.querySelector('#tp-watch');
  const ACTIVE     = ROOT.querySelector('#tp-active');
  const BTN_AUTO   = ROOT.querySelector('#tp-auto-btn');
  const BTN_KS     = ROOT.querySelector('#tp-ks');
  const BTN_BUY    = ROOT.querySelector('#tp-buy-btn');
  const BTN_SELL   = ROOT.querySelector('#tp-sell-btn');
  const PL_BOX     = ROOT.querySelector('#tp-pl-body');

  // ------------------ Local UI state ------------------
  const watchSet     = new Set(); // symbols in Watchlist
  const activeSet    = new Set(); // symbols currently Active
  const statusBySym  = new Map(); // sym -> 'idle'|'pending'|'ok'|'fail'

  // default notional per click (USD-ish)
  window.CYCLA.ORDER_USD ??= 3;

  // browser-side AUTO gate (chart's auto executor checks this)
  window.AUTO = false;

  // ------------------ Helpers shared with manual trade ------------------

  // normalize "BTC-USD" / "BTC/USD" / "btc usd" → "BTCUSD"
  function uiNormalize(sym){
    return String(sym||'')
      .toUpperCase()
      .replace(/[\/\-\s]/g,'');
  }

  // convert "BTCUSD" → "BTC-USD" etc.
  function toProductId(sym){
    const s = String(sym||'').toUpperCase().replace(/\s+/g,'').replace(/\//g,'-');
    if (s.includes('-')) return s; // already BASE-QUOTE
    const QUOTES = ['USDC','USD','EUR','GBP']; // longest first so USDC beats USD
    for (const q of QUOTES){
      if (s.endsWith(q) && s.length > q.length){
        return s.slice(0, -q.length) + '-' + q;
      }
    }
    return s;
  }

  // very loose Coinbase/Robinhood crypto pair check, e.g. BTC-USD, SOL-USD, etc.
  function isCoinbaseProduct(id){
    const m = String(id||'').toUpperCase().match(/^([A-Z0-9]+)-(USD|USDC|EUR|GBP)$/);
    if (!m) return false;
    const base = m[1];
    return /[A-Z]/.test(base);
  }

  function decimals(x){
    const s = String(x);
    const i = s.indexOf('.');
    return i < 0 ? 0 : s.length - i - 1;
  }

  // round v to step, with mode = 'floor' | 'ceil' | 'round'
  function roundToStep(v, step, mode='round'){
    const n = Math.max(0, decimals(step));
    const k = v / step;
    const r = mode === 'floor' ? Math.floor(k)
            : mode === 'ceil'  ? Math.ceil(k)
            : Math.round(k);
    return +(r * step).toFixed(n);
  }

  // heuristic tick for USD-ish quotes
  function priceStepFor(quote, p){
    const q = String(quote||'').toUpperCase();
    if (q==='USD' || q==='USDC' || q==='EUR' || q==='GBP'){
      return p < 1 ? 0.0001 : 0.01;
    }
    return 0.00000001; // fallback for crypto quotes
  }

  const BASE_SIZE_STEP = 0.000001; // we floor size to this

  // ------------------ LED helpers ------------------
  function applyStatusToRow(row, sym){
    if (!row) return;
    const left = row.querySelector('.tp-left .tp-sym');
    if (left){
      left.textContent = sym;
    }

    const led = row.querySelector('.tp-led');
    if (!led) return;

    const st = statusBySym.get(sym) || 'idle';

    led.classList.remove('tp-led--idle','tp-led--pending','tp-led--ok','tp-led--fail');
    if (st === 'pending') led.classList.add('tp-led--pending');
    else if (st === 'ok') led.classList.add('tp-led--ok');
    else if (st === 'fail') led.classList.add('tp-led--fail');
    else led.classList.add('tp-led--idle');

    row.setAttribute('aria-label', `${sym} — ${st}`);
  }

  function updateActiveRowLED(sym){
    const row = ACTIVE.querySelector(`.tp-row-item[data-sym="${sym}"]`);
    if (row){
      applyStatusToRow(row, sym);
    }
  }

  // ------------------ Row builders ------------------
  function makeRow(sym, where){
    const row = document.createElement('div');
    row.className = 'tp-row-item';
    row.setAttribute('role','listitem');
    row.dataset.sym = sym;
    row.tabIndex = 0;

    const left = document.createElement('div');
    left.className = 'tp-left';

    const name = document.createElement('div');
    name.className = 'tp-sym';
    name.textContent = sym;
    left.appendChild(name);

    const mini = document.createElement('div');
    mini.className = 'tp-mini';

    const chip = document.createElement('div');
    chip.className = 'tp-chip';
    chip.textContent = where;
    mini.appendChild(chip);

    left.appendChild(mini);

    // right col: LED only for Active rows
    let right;
    if (where === 'Active'){
      right = document.createElement('div');
      const led = document.createElement('div');
      led.className = 'tp-led tp-led--idle';
      led.setAttribute('aria-hidden','true');
      right.appendChild(led);
    } else {
      right = document.createElement('div');
    }

    row.appendChild(left);
    row.appendChild(right);

    // click / enter loads that symbol on the chart
    function loadSym(){
      window.CYCLA.bus.dispatchEvent(
        new CustomEvent('cycla:load', { detail:{ symbol: sym } })
      );
    }
    row.addEventListener('click', loadSym);
    row.addEventListener('keydown', (e)=>{
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        loadSym();
      }
    });

    // if Active, sync LED status
    if (where === 'Active'){
      applyStatusToRow(row, sym);
    }

    return row;
  }

  function renderList(container, set, where){
    container.innerHTML = '';
    for(const sym of set){
      container.appendChild(makeRow(sym, where));
    }
  }

  // ------------------ AUTO / daemon sync wiring ------------------
  // Push AUTO state + watchlist/active set to the headless daemon.
  // When enabled=true: daemon should start trading every symbol in Active,
  // using its remembered TF for each symbol (tfBySymbol).
  async function syncDaemonAuto(enable){
    const DAEMON_BASE = DAEMON;
    if (!DAEMON_BASE) return; // if not provided, just run local UI logic

    try{
      const itemsArr = [];
      if (enable){
        for (const sym of activeSet){
          const tfSel =
            (window.CYCLA.tfBySymbol?.[sym] ||
             String(window?.CYCLA?.currentTF || '1m').toUpperCase());
          itemsArr.push({ symbol: sym, tf: tfSel });
        }
      }

      const body = {
        enabled: !!enable,
        orderUsd: Number(window?.CYCLA?.ORDER_USD ?? 3),
        items: itemsArr
      };

      await fetch(`${DAEMON_BASE}/auto`, {
        method:'POST',
        headers:{ 'Content-Type':'application/json' },
        body: JSON.stringify(body)
      });
    }catch(err){
      console.warn('[syncDaemonAuto] failed', err);
    }
  }

  // ------------------ AUTO button wiring ------------------
  function updateAutoVisual(){
    if (window.AUTO){
      BTN_AUTO.setAttribute('aria-pressed', 'true');
      BTN_AUTO.dataset.state = 'on';
      BTN_AUTO.classList.add('tp-auto-armed');
      BTN_AUTO.classList.remove('tp-auto-off');
    } else {
      BTN_AUTO.setAttribute('aria-pressed', 'false');
      BTN_AUTO.dataset.state = 'off';
      BTN_AUTO.classList.remove('tp-auto-armed');
      BTN_AUTO.classList.add('tp-auto-off');
    }
  }

  BTN_AUTO.addEventListener('click', async ()=>{
    // flip AUTO
    window.AUTO = !window.AUTO;
    console.log('[CYCLA AUTO] client AUTO is now', window.AUTO);

    if (window.AUTO){
      // broadcast start → chart listener tightens gating etc.
      window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:auto:start'));

      // keep your default per-trade USD
      window.CYCLA.ORDER_USD = 3;

      // promote watchlist items into Active once AUTO arms
      if (watchSet.size){
        for (const s of watchSet){
          activeSet.add(s);
          if (!statusBySym.has(s)) statusBySym.set(s, 'idle');
        }
        watchSet.clear();
        renderList(WATCH, watchSet, 'Watch');
        renderList(ACTIVE, activeSet, 'Active');
      }
    } else {
      window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:auto:stop'));
    }

    updateAutoVisual();

    // tell daemon about new AUTO state (arm/disarm for full watchlist)
    await syncDaemonAuto(window.AUTO);
  });

  // if something else says "stop", mirror that
  window.CYCLA.bus.addEventListener('cycla:auto:stop', ()=>{
    window.AUTO = false;
    updateAutoVisual();
  });

  // ------------------ KS button wiring ------------------
  BTN_KS.addEventListener('click', async ()=>{
    // broadcast stop so AUTO shuts down
    window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:auto:stop'));

    // nuke active trades / reset P&L / reset LEDs
    window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:trades:clear'));

    // force AUTO visuals "off"
    window.AUTO = false;
    updateAutoVisual();

    // hard kill on relay side, if available
    if (RELAY){
      try {
        await fetch(`${RELAY}/killswitch`, { method:'POST' });
      } catch(_){}
    }
  });

  // init AUTO button visuals
  updateAutoVisual();

  // ------------------ P/L HUD + ledger ------------------
  const fmtUSD = (n)=>
    Number(n||0).toLocaleString(
      'en-US',
      { minimumFractionDigits:2, maximumFractionDigits:2 }
    );

  function feeRate(){
    const F = window?.CYCLA?.FEE || {};
    const book = F[F.venue || 'spot'] || { maker:0, taker:0 };
    const mode = F.mode || 'taker';
    return Number(book[mode] ?? 0);
  }

  // floor $3 worth of coin to ~1e-6 base step
  function sizeForPrice(p){
    const usd  = Number(window?.CYCLA?.ORDER_USD ?? 3);
    const step = 0.000001;
    const raw  = usd / p;
    const sized = Math.floor(raw / step) * step;
    return Math.max(0, +sized.toFixed(6));
  }

  // running ledger of open/closed positions for HUD
  const ledger = {
    open:   new Map(), // sym -> {price, qty, time}
    closed: [],
    totals: { buys:0, sells:0, gross:0, fees:0, net:0, wins:0, losses:0 }
  };

  // expose ledger so chart (AUTO) can inspect current position sizes
  window.CYCLA.ledger = ledger;

  // helper: given symbol, side, and reference price, decide how much to trade
  // - for SELL: try to unload the full open qty for that ticker
  // - for BUY: fall back to ~$3 notional
  window.CYCLA.chooseQtyForSidePx = function(symUI, side, px){
    const normSym = String(symUI||'')
      .toUpperCase()
      .replace(/[\/\-\s]/g,'');

    if (side === 'SELL' && window.CYCLA.ledger?.open?.has(normSym)){
      const pos = window.CYCLA.ledger.open.get(normSym);
      if (pos && pos.qty > 0){
        return pos.qty; // dump full bag
      }
    }

    // BUY sizing (or SELL fallback): ~$3 worth, floored to 1e-6
    const usd  = Number(window?.CYCLA?.ORDER_USD ?? 3);
    const step = 0.000001;
    const raw  = usd / px;
    const sized = Math.floor(raw / step) * step;
    return Math.max(0, +sized.toFixed(6));
  };

  // last seen mark price per symbol (for unrealized P/L calc)
  const lastPrice = new Map();

  function renderPLFromTotals(){
    const t = ledger.totals;
    const mode  = (window?.CYCLA?.FEE?.mode  || 'taker');
    const venue = (window?.CYCLA?.FEE?.venue || 'spot');

    let text =
      `Buys: ${t.buys}   Sells: ${t.sells}\n` +
      `Realized: $${fmtUSD(t.net)}   (Gross $${fmtUSD(t.gross)} • Fees $${fmtUSD(t.fees)})\n`;

    const u = liveUnrealized();
    if (Number.isFinite(u.uNet) && (ledger.open.size > 0)){
      text += `Unrealized: $${fmtUSD(u.uNet)}   Open: ${ledger.open.size} pos`;
    }

    // tack on fee context
    text += `\nFee: ${mode} @ ${venue}`;

    PL_BOX.textContent = text;
  }

  // de-dupe legs so we don't double-book fills
  const _legSeen = new Map();
  function _legKey(d){
    return `${d.symbol}|${d.side}|${d.time}|${+d.price}|${+d.qty}`;
  }
  function rememberLegOnce(d, ttlMs = 5*60*1000){
    const now = Date.now();
    for (const [k, until] of _legSeen){
      if (until <= now) _legSeen.delete(k);
    }
    const key = _legKey(d);
    if (_legSeen.has(key)) return false;
    _legSeen.set(key, now + ttlMs);
    return true;
  }

  function addLeg({ symbol, side, price, qty, time }){
    const sym = uiNormalize(symbol);
    const q   = Number(qty || sizeForPrice(Number(price)));
    const px  = Number(price);
    if (!sym || !Number.isFinite(px) || !Number.isFinite(q) || q <= 0) return;
    if (!rememberLegOnce({symbol:sym, side, price:px, qty:q, time})) return;

    if (side === 'BUY'){
      const o = ledger.open.get(sym);
      if (o){
        const newQty = +(o.qty + q).toFixed(6);
        const newPx  = +((o.qty * o.price + q * px) / newQty).toFixed(8);
        ledger.open.set(sym, { price:newPx, qty:newQty, time: o.time ?? time });
      } else {
        ledger.open.set(sym, { price:px, qty:q, time });
      }
      ledger.totals.buys += 1;
      lastPrice.set(sym, px);
    }
    else if (side === 'SELL'){
      ledger.totals.sells += 1;
      const o = ledger.open.get(sym);
      if (o){
        const fr       = feeRate();
        const closeQty = Math.min(o.qty, q);
        const buyUsd   = closeQty * o.price;
        const sellUsd  = closeQty * px;
        const fees     = buyUsd * fr + sellUsd * fr;
        const gross    = sellUsd - buyUsd;
        const net      = gross - fees;

        ledger.closed.push({
          symbol:sym,
          buy:{...o, qty:closeQty},
          sell:{ price:px, qty:closeQty, time },
          gross, fees, net
        });

        ledger.totals.gross  += gross;
        ledger.totals.fees   += fees;
        ledger.totals.net    += net;
        if (net >= 0) ledger.totals.wins += 1;
        else          ledger.totals.losses += 1;

        o.qty = +(o.qty - closeQty).toFixed(6);
        if (o.qty <= 0){
          ledger.open.delete(sym);
        } else {
          ledger.open.set(sym, o);
        }
      }
    }

    renderPLFromTotals();
  }

  function liveUnrealized(){
    const fr = feeRate();
    let uGross = 0, uFees = 0;
    for (const [sym, o] of ledger.open){
      const p = lastPrice.get(sym);
      if (!Number.isFinite(p)) continue;
      const buyUsd   = o.qty * o.price;
      const closeUsd = o.qty * p;
      uGross += (closeUsd - buyUsd);
      uFees  += buyUsd * fr + closeUsd * fr;
    }
    return { uGross, uFees, uNet: uGross - uFees };
  }

  // snapshot P/L if we have no real fills yet (visible markers from chart)
  function computeFromSnapshot(payload){
    if (ledger.closed.length || ledger.open.size) return; // real > snapshot
    if(!payload || !payload.markers || !payload.visible || !payload.priceByTime) return;

    const { from, to } = payload.visible || {};
    const priceByTime = payload.priceByTime || {};
    const markers = (payload.markers || []).filter(m =>
      typeof m?.time === 'number' &&
      m.time >= from &&
      m.time <= to
    );

    const fr = feeRate();
    let buys=0, sells=0, gross=0, fees=0;
    let open = null;

    for (const m of markers){
      let side = String(m?.text||'').toUpperCase();
      if (side !== 'BUY' && side !== 'SELL'){
        if (m.position === 'belowBar') side = 'BUY';
        else if (m.position === 'aboveBar') side = 'SELL';
        else continue;
      }

      const px = Number(priceByTime[m.time] ?? m.price ?? NaN);
      if (!Number.isFinite(px) || px<=0) continue;

      if (side === 'BUY'){
        open = { price:px };
        buys++;
      } else if (side === 'SELL' && open){
        const q  = sizeForPrice(open.price);
        const bU = q * open.price;
        const sU = q * px;
        const f  = bU * fr + sU * fr;
        const g  = sU - bU;
        gross += g;
        fees  += f;
        sells++;
        open = null;
      }
    }

    PL_BOX.textContent =
      `Buys: ${buys}   Sells: ${sells}\n` +
      `Gross: $${fmtUSD(gross)}   Fees: $${fmtUSD(fees)}\n` +
      `Net: $${fmtUSD(gross - fees)}  [sim]`;
  }

  // ------------------ Manual order executor (BUY / SELL buttons) ------------------
  async function manualOrder(side){
    // Pull current chart-highlighted symbol / TF / price / bar time
    const symUI  = uiNormalize(window?.CYCLA?.symbolNow?.() || '');
    const tf     = String(window?.CYCLA?.currentTF || '1m').toUpperCase();
    const pxRaw  = Number(window?.CYCLA?.priceNow?.() ?? NaN);
    const barT   = Number(window?.CYCLA?.timeNow?.() ?? Math.floor(Date.now()/1000));

    if (!symUI || !Number.isFinite(pxRaw) || pxRaw <= 0){
      console.warn('[manualOrder] missing symbol / price; abort', {symUI, pxRaw});
      return;
    }

    // Build product_id like "BTC-USD"
    const product_id = toProductId(symUI);
    if (!isCoinbaseProduct(product_id)){
      console.warn('[manualOrder] not a valid product_id for relay', product_id);
      return;
    }

    // Round limit price to tick:
    const [, quote] = product_id.split('-');
    const pStep     = priceStepFor(quote, pxRaw);
    const limitPx   = (side === 'SELL')
      ? roundToStep(pxRaw, pStep, 'ceil')   // SELL nudges up to next tick
      : roundToStep(pxRaw, pStep, 'floor'); // BUY nudges down to next tick

    // Choose size using the shared global logic (SELL dumps full bag, BUY ~ $3)
    const rawQty    = window.CYCLA.chooseQtyForSidePx(symUI, side, limitPx);
    const qtyRounded = roundToStep(rawQty, BASE_SIZE_STEP, 'floor');

    if (!Number.isFinite(limitPx) || limitPx <= 0 ||
        !Number.isFinite(qtyRounded) || qtyRounded <= 0){
      console.warn('[manualOrder] bad rounded px/qty', {limitPx, qtyRounded});
      return;
    }

    // freeze TF for that symbol (so AUTO can't snipe same ticker on a diff TF later)
    window.CYCLA.tfBySymbol[symUI] = tf;

    // Immediately reflect "pending" in Active Trades HUD
    statusBySym.set(symUI, 'pending');
    // make sure symbol is in Active list visually
    if (!activeSet.has(symUI)){
      activeSet.add(symUI);
      renderList(ACTIVE, activeSet, 'Active');
    }
    updateActiveRowLED(symUI);

    // Fire an optimistic leg + queued event so P/L HUD reacts *now*
    // NOTE: this mirrors chart's 'cycla:order:queued' payload
    const queuedDetail = {
      symbol: symUI,
      tf,
      side,
      time: barT,
      price: limitPx,
      qty: qtyRounded,
      usd: Number(window?.CYCLA?.ORDER_USD ?? 3)
    };

    // tell P/L HUD and other panels
    window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:order:queued', {
      detail: queuedDetail
    }));

    // Also stuff it into ledger locally, in case the other listener didn't run yet
    addLeg({
      symbol: symUI,
      side,
      price: limitPx,
      qty: qtyRounded,
      time: barT
    });

    // Prepare request body for relay /order (relay = Robinhood adapter now)
    const body = {
      symbol: product_id,
      side,                       // "BUY" | "SELL"
      price: limitPx,
      size: qtyRounded,
      seconds: 60,                // wait up to ~60s
      client_order_id: `${symUI}-${tf}-${barT}-${side}-manual`
    };

    console.log('POST /order body →', body);

    // Actually send order to RELAY
    if (!RELAY){
      console.warn('[manualOrder] RELAY missing, skipping fetch');

      // mark as fail since we couldn't even send
      statusBySym.set(symUI, 'fail');
      updateActiveRowLED(symUI);
      window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:order:status', {
        detail:{ symbol:symUI, status:'fail' }
      }));
      return;
    }

    const t0 = Date.now();
    try{
      const res = await fetch(`${RELAY}/order`, {
        method:"POST",
        headers:{ "Content-Type":"application/json" },
        body: JSON.stringify(body)
      });
      const ms = Date.now() - t0;
      let json;
      try{ json = await res.json(); }catch(_){}
      console.log(`POST /order ← ${res.status} ${res.statusText} in ${ms}ms`, json);

      const finalState = window.CYCLA.finalStatusFromOrderResponse(json);

      statusBySym.set(symUI, finalState);
      updateActiveRowLED(symUI);

      // broadcast truthfully so any other panels / listeners sync correctly
      window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:order:status', {
        detail:{
          symbol: symUI,
          status: finalState,
          filled_qty: Number(json?.result?.filled ?? 0),
          backend_status: json?.result?.action
        }
      }));

    }catch(err){
      console.warn('manualOrder fetch failed:', err);
      statusBySym.set(symUI, 'fail');
      updateActiveRowLED(symUI);
      window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:order:status', {
        detail:{ symbol:symUI, status:'fail' }
      }));
    }
  }

  BTN_BUY.onclick  = ()=> manualOrder('BUY');
  BTN_SELL.onclick = ()=> manualOrder('SELL');

  // ------------------ Cross-widget event wiring ------------------

  // live price ticks keep unrealized P/L up to date
  window.CYCLA.bus.addEventListener('cycla:price:tick', (e)=>{
    const d = e.detail || {};
    const sym = uiNormalize(d.symbol);
    const px  = Number(d.price);
    if (!sym || !Number.isFinite(px)) return;
    lastPrice.set(sym, px);
    if (ledger.open.has(sym)){
      renderPLFromTotals();
    }
  });

  // initial snapshot from chart markers → seed P/L HUD before any fills
  window.CYCLA.bus.addEventListener('cycla:chart:markers', (e)=>{
    computeFromSnapshot(e.detail || {});
  });

  // generic "this trade leg executed" event from anywhere (AUTO, manual, backend push, etc)
  window.CYCLA.bus.addEventListener('cycla:pl:leg', (e)=>{
    addLeg(e.detail || {});
  });

  // order queued (AUTO path / manual path emits this too)
  window.CYCLA.bus.addEventListener('cycla:order:queued', (e)=>{
    addLeg(e.detail || {});
  });

  // external order status updates (AUTO path already emits this)
  // detail: { symbol:"BTCUSD", status:"pending"|"ok"|"fail" }
  window.CYCLA.bus.addEventListener('cycla:order:status', (e)=>{
    const d   = e.detail || {};
    const sym = uiNormalize(d.symbol || '');
    const st  = d.status || 'idle';
    if (!sym) return;

    // ensure symbol visible in Active
    if (!activeSet.has(sym)){
      activeSet.add(sym);
      if (!statusBySym.has(sym)) statusBySym.set(sym, 'idle');
      renderList(ACTIVE, activeSet, 'Active');
    }

    statusBySym.set(sym, st);
    updateActiveRowLED(sym);
  });

  // global nuke (killswitch etc.)
  window.CYCLA.bus.addEventListener('cycla:trades:clear', ()=>{
    activeSet.clear();
    renderList(ACTIVE, activeSet, 'Active');

    statusBySym.clear(); // LEDs reset

    ledger.open.clear();
    ledger.closed.length = 0;
    ledger.totals = {
      buys:0, sells:0, gross:0, fees:0, net:0, wins:0, losses:0
    };
    renderPLFromTotals();
  });

  // watchlist:add (user flags a symbol to stalk or chart's W button fires this)
  // detail: { symbol:"BTCUSD", tf:"1m" }
  window.CYCLA.bus.addEventListener('cycla:watchlist:add', (e)=>{
    const d   = e.detail || {};
    const sym = uiNormalize(d.symbol || '');
    if(!sym) return;

    // record TF at add-time, charts/AUTO use this
    if (d.tf) window.CYCLA.tfBySymbol[sym] = String(d.tf).toUpperCase();

    // don't duplicate
    if (activeSet.has(sym)) return;
    if (!watchSet.has(sym)) watchSet.add(sym);

    renderList(WATCH, watchSet, 'Watch');
  });

  // legacy trades:add -> treat like watchlist:add
  window.CYCLA.bus.addEventListener('cycla:trades:add', (e)=>{
    const d   = e.detail || {};
    const sym = uiNormalize(d.symbol || '');
    if(!sym) return;

    if (d.tf) window.CYCLA.tfBySymbol[sym] = String(d.tf).toUpperCase();

    if (activeSet.has(sym) || watchSet.has(sym)) return;
    watchSet.add(sym);
    renderList(WATCH, watchSet, 'Watch');
  });

  // first paint
  renderList(WATCH, watchSet, 'Watch');
  renderList(ACTIVE, activeSet, 'Active');
  renderPLFromTotals();
})();
</script>
