<!-- CYCLA • Screener (233x523) • Squarespace-ready • uses TwelveData + SMFT -->
<div id="cycla-screener-center">
  <!-- Add data-glue="1" to pin top-left inside a positioned parent container -->
  <div id="cycla-screener-widget" role="region" aria-label="Cycla Screener"
       data-td-key="YOUR_TWELVEDATA_KEY_HERE">
    <!-- Title (glued to top-left of parent) -->
    <div class="sc-label">Cycla Screener</div>

    <!-- Controls row -->
    <div class="sc-tools" aria-label="Screener Controls">
      <select id="sc-asset" class="sc-tool sc-dd" aria-label="Asset Class">
        <option>Crypto</option>
        <option>Stocks</option>
        <option>FX</option>
        <option>ETF</option>
        <option>All</option>
      </select>

      <select id="sc-tf" class="sc-tool sc-dd" aria-label="Timeframe">
        <option value="10m">10m</option>
        <option value="1H">1H</option>
        <option value="1D">1D</option>
        <option value="1W">1W</option>
        <option value="1M">1M</option>
        <option value="3+">3+</option>
      </select>

      <button id="sc-play" class="sc-tool sc-icn" aria-label="Play/Pause" title="Play">
        ▶
      </button>
      <button id="sc-stop" class="sc-tool sc-icn" aria-label="Stop" title="Stop">
        ■
      </button>
    </div>

    <!-- Scroll banner HUD (status) -->
    <div class="sc-banner" aria-live="polite">
      <div class="sc-banner-track" id="sc-banner-track">Idle.</div>
    </div>

    <!-- Results HUD -->
    <div class="sc-results" id="sc-results" role="list" aria-label="Scan results">
      <!-- dynamic rows -->
    </div>

    <!-- ECU HUD -->
    <div class="sc-ecu" aria-live="polite">
      <span class="sc-led" id="sc-led" title="Status LED" aria-hidden="true"></span>
      <span class="sc-ecu-msg" id="sc-ecu-msg">ECU idle.</span>
      <div class="sc-ecu-tools">
        <button id="sc-copy" class="sc-ecu-btn" aria-label="Copy ECU log" title="Copy">⧉</button>
        <button id="sc-clear" class="sc-ecu-btn" aria-label="Clear ECU log" title="Clear">✕</button>
      </div>
    </div>
  </div>
</div>

<style>
  /* ───── Layout container: center by default ───── */
  #cycla-screener-center { width:100%; display:flex; align-items:center; justify-content:center; }
  /* ───── Root widget ───── */
  #cycla-screener-widget{
    position:relative; width:233px; height:523px;
    background:linear-gradient(180deg, #eef4ff 0%, #eaf0fb 100%);
    border:1px solid rgba(10,20,40,.12); border-radius:12px;
    box-shadow:0 18px 55px rgba(8,16,40,.12), 0 2px 10px rgba(8,16,40,.08);
    font: 12px/1.25 system-ui, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    color:#1b2a4a; overflow:hidden;
  }
  /* Optional glue mode (pin to top-left of nearest positioned parent) */
  #cycla-screener-widget[data-glue="1"]{
    position:absolute; top:0; left:0; margin:0;
  }

  /* Label */
  #cycla-screener-widget .sc-label{
    position:absolute; top:8px; left:8px; z-index:3;
    font-weight:800; font-size:12px; letter-spacing:.3px; color:#3b4a6b;
    background:rgba(255,255,255,.78);
    border:1px solid rgba(10,20,40,.12);
    border-radius:8px; padding:6px 10px;
    backdrop-filter:saturate(140%) blur(4px);
  }

  /* Controls row */
  #cycla-screener-widget .sc-tools{
    position:absolute; top:44px; left:8px; right:8px;
    display:flex; gap:6px; align-items:center; justify-content:flex-start;
    height:34px;
  }
  .sc-tool{
    height:34px; min-width:34px; border-radius:10px; border:1px solid rgba(10,20,40,.14);
    background:#fff; box-shadow:0 13px 21px rgba(8,16,40,.18);
    display:inline-flex; align-items:center; justify-content:center; font-weight:700; color:#1b2a4a;
  }
  .sc-dd{ width:55px; padding:0 6px; appearance:none; cursor:pointer; }
  .sc-icn{ width:34px; cursor:pointer; }

  /* Banner HUD */
  .sc-banner{
    position:absolute; top:84px; left:8px; right:8px; height:34px;
    border-radius:10px; border:1px solid rgba(10,20,40,.14);
    background:rgba(255,255,255,.9);
    overflow:hidden; display:flex; align-items:center;
  }
  .sc-banner-track{
    white-space:nowrap; padding:0 10px; font-weight:800; animation: scroller 18s linear infinite;
  }
  @keyframes scroller{
    0%{ transform:translateX(0); } 100%{ transform:translateX(-60%); }
  }

  /* Results HUD */
  .sc-results{
    position:absolute; top:124px; left:8px; right:8px; height:377px;
    border-radius:10px; border:1px solid rgba(10,20,40,.14);
    background:linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
    overflow:auto; padding:6px;
  }
  .sc-row{
    display:flex; align-items:center; justify-content:space-between;
    padding:8px; margin:4px 0; border:1px solid rgba(10,20,40,.12);
    border-radius:8px; background:#fff; cursor:pointer;
  }
  .sc-row:hover{ background:#eef4ff; }
  .sc-sym{ font-weight:900; letter-spacing:.2px; }
  .sc-badges{ display:flex; gap:4px; flex-wrap:wrap; }
  .sc-badge{
    padding:2px 6px; border-radius:6px; border:1px solid rgba(10,20,40,.12);
    font-weight:800; font-size:11px; line-height:1;
  }
  .sc-badge.pass{ background:#d7f8e0; }
  .sc-badge.fail{ background:#f7e1ec; }

  /* ECU HUD (glued to bottom) */
  .sc-ecu{
    position:absolute; left:8px; right:8px; bottom:8px; height:34px;
    border-radius:10px; border:1px solid rgba(10,20,40,.14);
    background:rgba(255,255,255,.95); display:flex; align-items:center; padding:0 8px;
    gap:8px;
  }
  .sc-led{
    width:8px; height:8px; border-radius:50%;
    background:#9aa4b2; border:1px solid rgba(10,20,40,.35);
    box-shadow:0 0 0 2px rgba(10,20,40,.06) inset;
  }
  .sc-ecu-msg{ flex:1; font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .sc-ecu-tools{ display:flex; gap:6px; }
  .sc-ecu-btn{
    width:18px; height:18px; border-radius:6px; border:1px solid rgba(10,20,40,.2);
    background:#fff; font-size:10px; line-height:1; display:flex; align-items:center; justify-content:center; cursor:pointer;
  }
</style>

<script>
(()=>{

  const ROOT = document.getElementById('cycla-screener-widget');
  const TD_KEY = ROOT.getAttribute('data-td-key') || '';
  const LED   = ROOT.querySelector('#sc-led');
  const ECU   = ROOT.querySelector('#sc-ecu-msg');
  const ROWS  = ROOT.querySelector('#sc-results');
  const BTRACK= ROOT.querySelector('#sc-banner-track');

  const DD_ASSET = ROOT.querySelector('#sc-asset');
  const DD_TF    = ROOT.querySelector('#sc-tf');
  const BTN_PLAY = ROOT.querySelector('#sc-play');
  const BTN_STOP = ROOT.querySelector('#sc-stop');
  const BTN_COPY = ROOT.querySelector('#sc-copy');
  const BTN_CLEAR= ROOT.querySelector('#sc-clear');

  // Colors consistent with your chart widget
  const COLORS = {
    up: '#14B8A6', down: '#723085',
    ok: '#22c55e', warn:'#f59e0b', err:'#ef4444', idle:'#9aa4b2'
  };

  // Universe (override by setting window.CYCLA_UNIVERSE.* before this script runs)
  const UNIVERSE = Object.assign({
    Crypto: ['BTC-USD','ETH-USD','SOL-USD','XRP-USD','ADA-USD'],
    Stocks: ['AAPL','MSFT','NVDA','AMZN','TSLA'],
    FX:     ['EUR-USD','USD-JPY','GBP-USD','USD-CHF'],
    ETF:    ['SPY','QQQ','IWM','XLK'],
  }, (window.CYCLA_UNIVERSE || {}));
  function allUniverse(){
    const s = new Set([].concat(UNIVERSE.Crypto||[], UNIVERSE.Stocks||[], UNIVERSE.FX||[], UNIVERSE.ETF||[]));
    return Array.from(s);
  }

  // Timeframe mapping → TwelveData
  const TFMAP = { '10m':'10min', '1H':'1h', '1D':'1day', '1W':'1week', '1M':'1month' };
  const TF_FAN = ['10m','1H','1D','1W','1M']; // used for "3+"

  // Safety caps (RPM)
  const OUTPUTSIZE = 320;          // enough for SMFT/ATR RMA convergence
  const SYMBOL_DELAY_MS = 900;     // mild throttle between symbols
  const TF_DELAY_MS = 0;           // per-TF delay (0; batched per symbol)

  // ECU log
  const ecuLog = [];
  function logECU(msg, level='info'){
    const tag = level.toUpperCase();
    const stamp = new Date().toISOString().replace('T',' ').replace('Z','');
    const line = `[${stamp}] [${tag}] ${msg}`;
    ecuLog.push(line);
    ECU.textContent = msg;
    if(level === 'error') setLED('err');
  }
  function setLED(kind){
    const col = { ok:COLORS.ok, warn:COLORS.warn, err:COLORS.err, idle:COLORS.idle }[kind] || COLORS.idle;
    LED.style.background = col;
  }

  // Event bus (2-way comms with chart)
  function emit(name, detail){ window.dispatchEvent(new CustomEvent(name, { detail })); }

  // Listen to chart status & errors to mirror in ECU
  window.addEventListener('cycla:chart-status', (e)=>{
    const d = e.detail||{};
    if(d.status === 'ready'){ setLED('ok'); ECU.textContent = `Chart: ${d.symbol||'-'} ${d.tf||''} ready`; }
    if(d.status === 'loading'){ setLED('warn'); ECU.textContent = `Chart loading ${d.symbol||''} ${d.tf||''}...`; }
  });
  window.addEventListener('cycla:error', (e)=>{
    const { source='chart', message='Error' } = (e.detail||{});
    logECU(`${source}: ${message}`, 'error');
  });

  // Scroll banner helper
  function banner(text){ BTRACK.textContent = text; }

  // ───────────── TwelveData + SMFT (kept 1:1 with chart logic) ─────────────
  const toEpoch = (iso) => Math.floor(new Date(iso.replace(' ', 'T')+'Z').getTime()/1000);
  function trueRange(h, l, pc){ if(pc == null) return h-l; return Math.max(h-l, Math.abs(h-pc), Math.abs(l-pc)); }
  function rmaNext(prev, x, len){ return (prev==null) ? x : (prev*(len-1)+x)/len; }
  const SMFT_PARAMS = { xi:3.0, eSatPct:8.0, gamma:8.0, atrLen:5 };
  const OSC_PARAMS  = { bandK:0.34, bandLen:34 };
  function smftAlpha(atrPct, p){ const xiMem = Math.max(1, p.xi / (1 + Math.pow(atrPct / p.eSatPct, p.gamma))); return 2 / (xiMem + 1); }

  async function fetchTDSeries(symbol, interval, size=OUTPUTSIZE){
    if(!TD_KEY) throw new Error('Missing TwelveData API key on Screener widget.');
    const url = new URL('https://api.twelvedata.com/time_series');
    url.searchParams.set('symbol', symbol);
    url.searchParams.set('interval', interval);
    url.searchParams.set('outputsize', String(size));
    url.searchParams.set('timezone', 'UTC');
    url.searchParams.set('format', 'JSON');
    url.searchParams.set('order', 'ASC');
    url.searchParams.set('apikey', TD_KEY);
    const res = await fetch(url.toString());
    const data = await res.json();
    if(data.status === 'error' || !data.values){ throw new Error(data.message || 'TwelveData error'); }
    return data.values.map(v => ({
      time:  toEpoch(v.datetime),
      open:  +v.open, high: +v.high, low: +v.low, close:+v.close
    }));
  }

  // Compute LAST oscillator value for a bars array
  function oscLast(bars){
    let prevClose=null, atrRma=null, oP=null,hP=null,lP=null,cP2=null;
    let prevSmftClose=null, oscAbsRma=null, lastOsc=0;
    for(const b of bars){
      const tr = trueRange(b.high,b.low, prevClose);
      atrRma = rmaNext(atrRma, tr, SMFT_PARAMS.atrLen);
      const atrPct = (atrRma / (b.close||1)) * 100;
      const alpha = smftAlpha(atrPct, SMFT_PARAMS);

      if(oP==null){ oP=b.open; hP=b.high; lP=b.low; cP2=b.close; }
      else{
        oP  = oP  + alpha * (b.open  - oP);
        hP  = hP  + alpha * (b.high  - hP);
        lP  = lP  + alpha * (b.low   - lP);
        cP2 = cP2 + alpha * (b.close - cP2);
      }

      const dSmft = (prevSmftClose==null) ? 0 : (cP2 - prevSmftClose);
      const norm  = (atrRma || Math.abs(dSmft) || 1);
      lastOsc = dSmft / norm;

      prevSmftClose = cP2;
      prevClose = b.close;

      // (bands maintained for parity, but not required for >0 check)
      oscAbsRma = rmaNext(oscAbsRma, Math.abs(lastOsc), OSC_PARAMS.bandLen);
    }
    return lastOsc; // > 0 → pass
  }

  async function oscLastFor(symbol, tfKey){
    const interval = TFMAP[tfKey];
    const bars = await fetchTDSeries(symbol, interval, OUTPUTSIZE);
    return oscLast(bars);
  }

  // ───────────── Screening engine ─────────────
  const state = {
    running:false, paused:false, stopFlag:false,
    currentSym:'', scanned:0, hits:0
  };

  function pickUniverse(){
    const tag = DD_ASSET.value;
    if(tag === 'All') return allUniverse();
    return (UNIVERSE[tag] || []);
  }

  function rowEl(symbol, tfHits){
    const el = document.createElement('div');
    el.className = 'sc-row';
    el.setAttribute('role','listitem');
    el.innerHTML = `<span class="sc-sym">${symbol}</span><span class="sc-badges"></span>`;
    const badgel = el.querySelector('.sc-badges');
    (tfHits && tfHits.length ? tfHits : ['pass']).forEach(tf=>{
      const b = document.createElement('span');
      b.className = 'sc-badge pass';
      b.textContent = tf;
      badgel.appendChild(b);
    });
    el.addEventListener('click', ()=>{
      emit('cycla:load-symbol', { symbol: symbol.replace('/', '-'), tf: (DD_TF.value==='3+' ? '1H' : DD_TF.value) });
    });
    return el;
  }

  function sleep(ms){ return new Promise(r=>setTimeout(r, ms)); }

  async function screenSymbol(symbol, modeTf){
    if(modeTf !== '3+'){
      const v = await oscLastFor(symbol, modeTf);
      return { pass: v > 0, tfHits: v>0 ? [modeTf] : [] };
    }else{
      const vals = await Promise.all(TF_FAN.map(tf => oscLastFor(symbol, tf)));
      const hits = TF_FAN.filter((tf,i)=> vals[i] > 0);
      return { pass: hits.length >= 3, tfHits: hits };
    }
  }

  async function runScan(){
    const list = pickUniverse();
    if(!list.length){ banner('No symbols in selected universe.'); return; }

    state.running = true; state.paused = false; state.stopFlag = false;
    state.scanned = 0; state.hits = 0;
    setLED('warn');
    banner(`Scanning ${list.length} symbols… (${DD_ASSET.value} • ${DD_TF.value})`);
    ROWS.innerHTML = '';

    for(const sym of list){
      if(state.stopFlag) break;
      while(state.paused){ await sleep(150); if(state.stopFlag) break; }
      state.currentSym = sym;
      banner(`Scanning ${sym} • ${state.scanned+1}/${list.length} • hits ${state.hits}`);

      try{
        const { pass, tfHits } = await screenSymbol(sym, DD_TF.value);
        state.scanned++;
        if(pass){ state.hits++; ROWS.appendChild(rowEl(sym, tfHits)); }
      }catch(e){
        logECU(`screener ${sym}: ${e.message||e}`, 'error');
      }

      await sleep(SYMBOL_DELAY_MS);
    }

    if(!state.stopFlag){
      setLED('ok');
      banner(`Scan complete • ${state.scanned} scanned • ${state.hits} hits`);
    }else{
      setLED('idle');
      banner(`Scan stopped.`);
    }
    state.running = false;
  }

  // Controls
  BTN_PLAY.addEventListener('click', ()=>{
    if(!state.running){ BTN_PLAY.textContent = '⏸'; BTN_PLAY.title='Pause'; runScan(); }
    else if(!state.paused){ state.paused = true; BTN_PLAY.textContent = '▶'; BTN_PLAY.title='Resume'; banner(`Paused at ${state.currentSym}…`); setLED('idle'); }
    else { state.paused = false; BTN_PLAY.textContent = '⏸'; BTN_PLAY.title='Pause'; setLED('warn'); }
  });
  BTN_STOP.addEventListener('click', ()=>{
    state.stopFlag = true; state.paused = false; state.running = false;
    BTN_PLAY.textContent = '▶'; BTN_PLAY.title='Play';
  });

  BTN_COPY.addEventListener('click', async ()=>{
    try{ await navigator.clipboard.writeText(ecuLog.join('\n')); ECU.textContent='ECU copied.'; setLED('ok'); }catch(e){ logECU(`copy failed: ${e.message||e}`, 'error'); }
  });
  BTN_CLEAR.addEventListener('click', ()=>{ ecuLog.length=0; ECU.textContent='ECU cleared.'; setLED('idle'); });

  // init
  setLED('idle');
  banner('Idle. Select a universe and timeframe, then press ▶ to scan.');
})();
</script>
