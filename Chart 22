// Tolerant price lookup: last bar whose time <= t (handles resample/rounding drift)
function priceAtTime(t){
  const bars = current?.buf?.price || [];
  let lo = 0, hi = bars.length - 1, ans = -1;
  while (lo <= hi){
    const mid = (lo + hi) >> 1;
    if (bars[mid].time <= t){ ans = mid; lo = mid + 1; }
    else { hi = mid - 1; }
  }
  return ans >= 0 ? bars[ans].close : undefined;
}

// Emit-level de-dupe bookkeeping (unchanged)
const __evtSeen = new Map(); // key -> expiry timestamp (ms)

function __evtKey(symbol, tf, time, side) {
  return `${symbol}|${String(tf || '').toUpperCase()}|${time}|${side}`;
}

function __rememberOnce(key, ttlMs = 15 * 60 * 1000) { // 15 min TTL
  const now = Date.now();
  // GC expired entries
  for (const [k, until] of __evtSeen) {
    if (until <= now) __evtSeen.delete(k);
  }
  if (__evtSeen.has(key)) return false;
  __evtSeen.set(key, now + ttlMs);
  return true;
}

// ✅ UPDATED emitTradeSignals: NO feedFreshEnough() gating
function emitTradeSignals(symbolUI, tf, prevMarkers, nextMarkers) {
  try {
    const symbol = String(symbolUI || '')
      .toUpperCase()
      .replace(/[\/\-\s]/g, '');
    if (!symbol || !tf) return;

    // NOTE: we REMOVED:
    // if (!feedFreshEnough(tf)) { ... return; }

    // Build set of markers we already had, so we only react to brand-new ones
    const prevSet = new Set(
      (prevMarkers || []).map(
        m => `${m?.time}|${m?.text || m?.position || ''}`
      )
    );

    for (const m of (nextMarkers || [])) {
      if (!m || typeof m.time !== 'number') continue;

      // Only consider markers that are NEW this frame
      const markerKey = `${m.time}|${m.text || m.position || ''}`;
      if (prevSet.has(markerKey)) continue;

      // Resolve BUY/SELL side from marker
      let side = String(m?.text || '').toUpperCase();
      if (side !== 'BUY' && side !== 'SELL') {
        if (m.position === 'belowBar') side = 'BUY';
        else if (m.position === 'aboveBar') side = 'SELL';
        else continue; // can't classify, skip
      }

      // Fetch the price at that marker's bar time
      const px = Number(m?.price ?? NaN);
      const price = Number.isFinite(px) ? px : priceAtTime(m.time);
      if (!Number.isFinite(price) || price <= 0) continue;

      // Emit-level de-dupe so we don't spam repeats for same bar/side
      const onceKey = __evtKey(symbol, tf, m.time, side);
      if (!__rememberOnce(onceKey)) continue;

 // Compute printed/progress so Trades can gate strictly on "fully printed"
const lastBar = (current?.buf?.price || []).at(-1);
const tfSec = tfSeconds(tf);
const nowSec = Math.floor(Date.now() / 1000);
const isCurrentBar = !!lastBar && (m.time === lastBar.time);
const progress = isCurrentBar ? Math.max(0, Math.min(1, (nowSec - m.time) / tfSec)) : 1;
// "printed" means bar is closed OR at/above gate threshold on live bar
const GATE_PCT = (window?.CYCLA?.GATE_PCT ?? 0.80);
const printed = !isCurrentBar || (progress >= GATE_PCT);

// 🚀 FIRE the trade intent to AUTO queue (now with flags)
window.CYCLA.bus.dispatchEvent(
  new CustomEvent('cycla:signal', {
    detail: {
      symbol,        // "BTCUSD"
      tf,            // e.g. "1m"
      side,          // "BUY" | "SELL"
      time: m.time,
      price,         // numeric limit reference
      printed,       // ⟵ strict flag
      progress,      // ⟵ 0..1 on current bar (1 for closed)
      from: 'chart',
      closeOnly: (window?.CYCLA?.GATE_PCT === 1.0) // true when AUTO forces close-only
    }
  })
);

    }
  } catch (e) {
    console.warn('emitTradeSignals failed:', e);
  }
}

