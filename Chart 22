// Compute BUY/SELL markers with regime de-dupe + 80% gating on the live bar
function computeMarkers(priceBars, osc, up, dn, tf) {
  const markers = [];
  const closeByTime = new Map(priceBars.map(b => [b.time, b.close]));

  // Seed lastSide from what we already drew last time (if any)
  let lastSide = (Array.isArray(lastMarkers) && lastMarkers.length)
    ? lastMarkers[lastMarkers.length - 1].text
    : null;

  // Live-bar gating context
  const lastBar = priceBars[priceBars.length - 1];
  const tfSec   = tfSeconds(tf);
  const nowSec  = Math.floor(Date.now() / 1000);

  // Change to 1.0 if you want "close only"
  const GATE_PCT = (window?.CYCLA?.GATE_PCT ?? 0.80);

  for (let i = 1; i < osc.length; i++) {
    const t1 = osc[i].time;
    const v0 = osc[i - 1].value, v1 = osc[i].value;
    const u0 = up[i - 1].value,  u1 = up[i].value;
    const d0 = dn[i - 1].value,  d1 = dn[i].value;

    // Detect fresh cross
    let side = null;
    if (v0 <= u0 && v1 > u1) side = 'BUY';
    if (v0 >= d0 && v1 < d1) side = 'SELL';
    if (!side) continue;

    // 1) Regime de-dupe: skip if same as the last emitted side
    if (side === lastSide) continue;

    // 2) 80% gating: only gate if this marker is on the *current* bar
    if (lastBar && t1 === lastBar.time) {
      const progress = Math.max(0, Math.min(1, (nowSec - t1) / tfSec)); // 0→1 across the bar
      if (progress < GATE_PCT) continue;  // wait until ≥ 80% (or close)
    }

    // Emit exactly one marker
    markers.push({
      time: t1,
      position: side === 'BUY' ? 'belowBar' : 'aboveBar',
      shape:    side === 'BUY' ? 'arrowUp'  : 'arrowDown',
      color:    side === 'BUY' ? COLORS.up  : COLORS.down,
      text: side,
      price: closeByTime.get(t1)
    });

    lastSide = side; // update regime after emission
  }

  return markers;
}

