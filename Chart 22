<script>
(()=>{
// ───────────────────────── Config / Theme ─────────────────────────
const ROOT  = document.getElementById('cycla-chart-widget');
const TD_KEY = ROOT.getAttribute('data-td-key') || '';

// Shared namespace + bus (single source of truth)
window.CYCLA = window.CYCLA || {};

window.CYCLA.GATE_PCT = 0.80; // 1.0 = close-only

(window.CYCLA.tfBySymbol ||= Object.create(null));

window.CYCLA.TD_KEY = TD_KEY;                     // expose key for Screener fallback
window.CYCLA.bus = window.CYCLA.bus || new EventTarget();
const BUS = window.CYCLA.bus;
window.CYCLA.currentTF = window.CYCLA.currentTF || '1m';

// canonical chart state the rest of the app can read
window.CYCLA.currentSymbol = window.CYCLA.currentSymbol || '';
window.CYCLA.lastPrice     = window.CYCLA.lastPrice ?? undefined;

const RELAY = "https://spectra-trade-bot.onrender.com";
window.CYCLA.RELAY = RELAY; // ✅ expose to other widgets
 const DAEMON = "http://localhost:8080";   // local auto-daemon URL
  window.CYCLA.DAEMON = DAEMON;             // expose to other widgets
window.CYCLA.ORDER_USD = 3;   // default USD/ trade

// ---- /order fetch logger (once) --------------------------------------------
if (!window.__CYCLA_FETCH_LOGGER__) {
  window.__CYCLA_FETCH_LOGGER__ = true;
  const _fetch = window.fetch;

  window.fetch = async function (input, init) {
    const url = typeof input === 'string' ? input : (input && input.url) || '';
    const isOrder = url.includes('/order');
    const t0 = Date.now();

    // Log request body
    if (isOrder) {
      try {
        let bodyText = '';
        if (init && init.body) {
          bodyText = typeof init.body === 'string' ? init.body : await init.body?.text?.();
        } else if (input && typeof input !== 'string' && input.clone) {
          // Request object case
          bodyText = await input.clone().text();
        }
        try {
          console.log('POST /order body →', JSON.parse(bodyText));
        } catch {
          console.log('POST /order body (raw) →', bodyText);
        }
      } catch (err) {
        console.warn('order logging failed:', err);
      }
    }

    const res = await _fetch(input, init);

    // Log response status + JSON (non-blocking)
    if (isOrder) {
      console.log(`POST /order ← ${res.status} ${res.statusText} in ${Date.now() - t0}ms`);
      try { res.clone().json().then(j => console.log('POST /order resp ←', j)); } catch {}
    }
    return res;
  };
}
// ---------------------------------------------------------------------------

let AUTO = false;

let _loading = false;
async function safeLoad(sym, tf){
  if (_loading) return;
  _loading = true;
  try { await load(sym, tf); }
  finally { _loading = false; }
}

let current = { buf: { price: [] } };
let lastMarkers = []; // <-- keep this single, early declaration

function toProductId(sym){
  const s = String(sym||'').toUpperCase().replace(/\s+/g,'').replace(/\//g,'-');
  if (s.includes('-')) return s; // already hyphenated
  const QUOTES = ['USDC','USD','EUR','GBP']; // longest first so USDC beats USD
  for (const q of QUOTES){
    if (s.endsWith(q) && s.length > q.length){
      return s.slice(0, -q.length) + '-' + q;
    }
  }
  return s; // fallback (will be rejected by isCoinbaseProduct)
}

function isCoinbaseProduct(id){
  const m = String(id||'').toUpperCase().match(/^([A-Z0-9]+)-(USD|USDC|EUR|GBP)$/);
  if (!m) return false;
  const base = m[1];
  return /[A-Z]/.test(base); // must contain at least one letter
}

window.CYCLA.bus.addEventListener("cycla:auto:start", () => {
  AUTO = true;
  window.CYCLA.GATE_PCT = 1.0;   // trade only on CLOSED bars during AUTO
  console.debug('[AUTO] start → close-only');
});
window.CYCLA.bus.addEventListener("cycla:auto:stop",  () => {
  AUTO = false;
  window.CYCLA.GATE_PCT = 0.80;  // back to interactive preview while manual
  console.debug('[AUTO] stop  → preview gating (80%)');
});

// ─── Order de-dupe + queue (place ABOVE the listener) ───
const ORDER_TTL_MS    = 70_000;   // ignore repeat (symbol|tf|time|side) for 70s
const ORDER_SPACING_MS=   400;    // min spacing between POSTs
const MAX_RETRIES     =     6;    // retry 429s with backoff

const _seen = new Map();          // key -> firstSeen

function _gcSeen(){
  const now = Date.now();
  for (const [k, t] of _seen){
    if (now - t > ORDER_TTL_MS) _seen.delete(k);
  }
}

function _markIfNew(key){
  _gcSeen();
  if (_seen.has(key)) return false;
  _seen.set(key, Date.now());
  return true;
}

const _q = [];
let _draining = false;
let _lastSentAt = 0;

async function _drainQueue(){
  if (_draining) return;
  _draining = true;

  while (_q.length){
    const job = _q.shift();
    const symUI = job.uiSym; // e.g. "BTCUSD"

    // client-side spacing
    const wait = Math.max(0, ORDER_SPACING_MS - (Date.now() - _lastSentAt));
    if (wait) await new Promise(r => setTimeout(r, wait));
    _lastSentAt = Date.now();

    // POST with 429 backoff
    let attempt = 0;
    let backoff = 500;
    let success = false;

    for (;;){
      const res = await fetch(`${RELAY}/order`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(job.body)
      });

      if (res.ok) {
        success = true;
        break;
      }
      if (res.status !== 429 || attempt >= MAX_RETRIES) {
        success = false;
        break;
      }

      // still rate-limited → stay "pending"
      await new Promise(r => setTimeout(r, backoff + Math.floor(Math.random()*250)));
      backoff = Math.min(backoff * 2, 8000);
      attempt++;
    }

    // tell Trades HUD final status for this leg
    window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:order:status', {
      detail: {
        symbol: symUI,
        status: success ? 'ok' : 'fail'
      }
    }));
  }

  _draining = false;
}

function decimals(x){ const s=String(x); const i=s.indexOf('.'); return i<0?0:s.length-i-1; }

// upgrade helper to support 'ceil'
function roundToStep(v, step, mode='round'){
  const n = Math.max(0, decimals(step));
  const k = v / step;
  const r = mode === 'floor' ? Math.floor(k) : mode === 'ceil' ? Math.ceil(k) : Math.round(k);
  return +(r * step).toFixed(n);
}

// Coarse defaults that work well for Coinbase spot if you don't fetch per-product meta.
// USD/USDC/EUR/GBP: 0.01 for prices >= 1; 0.0001 for sub-dollar alts.
function priceStepFor(quote, p){
  const q = String(quote||'').toUpperCase();
  if (q==='USD' || q==='USDC' || q==='EUR' || q==='GBP'){
    return p < 1 ? 0.0001 : 0.01;
  }
  return 0.00000001; // fallback for crypto quotes
}

// --- constants reused from Trades panel ---
const BASE_SIZE_STEP = 0.000001;

// AUTO order consumer: identical semantics to manualOrder,
// BUT triggered automatically when an on-chart arrow prints.
window.CYCLA.bus.addEventListener("cycla:signal", (e) => {
  if (!AUTO) return;

  const { symbol, side, tf, time, price } = e.detail;

  // --- TF freeze per symbol (same safety you already had)
  try {
    const symKey = String(symbol||'').toUpperCase().replace(/[\/\-\s]/g,''); // "BTCUSD"
    const frozen = (window?.CYCLA?.tfBySymbol||{})[symKey];
    if (frozen && String(frozen).toUpperCase() !== String(tf).toUpperCase()) {
      console.debug('[AUTO] drop (TF mismatch)', { symbol: symKey, tf, frozen });
      return;
    }
  } catch {}

  const product_id = toProductId(symbol); // "BTC-USD"
  if (!isCoinbaseProduct(product_id)){
    console.warn("[AUTO] skip non-CB product", product_id);
    return;
  }

  if (!Number.isFinite(price) || price <= 0){
    console.warn("[AUTO] bad ref price", price);
    return;
  }

  // Tick rounding for limit price,
  // BUY floors, SELL ceils.
  const [, quote] = product_id.split('-');
  const pStep = priceStepFor(quote, price);
  const priceRounded = (side === 'SELL')
    ? roundToStep(price, pStep, 'ceil')
    : roundToStep(price, pStep, 'floor');

  // Size calc (~$3 buys or dump position on SELL)
  const uiSym = product_id.replace('-', ''); // "BTCUSD"
  const rawSz = window.CYCLA.chooseQtyForSidePx(uiSym, side, priceRounded);
  const sizeRounded = roundToStep(rawSz, BASE_SIZE_STEP, 'floor');

  // Sanity check
  if (!Number.isFinite(priceRounded) || priceRounded <= 0 ||
      !Number.isFinite(sizeRounded)  || sizeRounded  <= 0){
    console.warn("[AUTO] skip, invalid rounded px/qty", {
      priceRounded, sizeRounded, rawSz
    });
    return;
  }

  // Hard de-dupe: don't resubmit same bar/side twice
  const key = `${symbol}|${tf}|${time}|${side}`;
  if (!_markIfNew(key)) {
    return;
  }

  // HUD: mark pending
  window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:order:status', {
    detail: { symbol: uiSym, status: 'pending' }
  }));

  // P/L ledger pre-books it
  const usd = Number(window?.CYCLA?.ORDER_USD ?? 3);
  window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:order:queued', {
    detail: {
      symbol: uiSym,
      tf,
      side,
      time,
      price: priceRounded,
      qty:   sizeRounded,
      usd
    }
  }));

  // Lock this ticker to this TF for AUTO going forward
  (window.CYCLA.tfBySymbol ||= {})[uiSym] = tf;

  // Queue actual relay order
_q.push({
  uiSym,
  body: {
    symbol: product_id,             // ← key must be 'symbol'
    side,
    price: priceRounded,
    size:  sizeRounded,
    seconds: 60,
    client_order_id: `${symbol}-${tf}-${time}-${side}`
  }
});

  _drainQueue();
});

// Surface missing-key to Screener's ECU
if (!TD_KEY) {
  window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:ecu', {
    detail: { level: 'err', msg: 'Missing TwelveData key (chart).' }
  }));
}

// Let Screener load symbols into the chart without touching TF
window.CYCLA.bus.addEventListener('cycla:load', (e) => {
  const { symbol } = e.detail || {};
  if (!symbol) return;
  const tf = window.CYCLA.currentTF || '1m';
  try {
    safeLoad(symbol, tf);  // ← use safeLoad here
    window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:ecu', {
      detail: { level: 'ok', msg: `Chart loading ${symbol}…` }
    }));
  } catch (err) {
    window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:ecu', {
      detail: { level: 'err', msg: `Chart load failed: ${err?.message || err}` }
    }));
  }
});

const DEFAULT_SYMBOL = 'BTCUSD';

  // ► TZ PATCH: force all displayed times to Houston, TX (America/Chicago)
  const TIMEZONE = 'America/Chicago';
  const LOCALE = 'en-US';

  // ► NEW: TwelveData outputsize safety cap to keep custom TFs working
  const TD_LIMIT = 5000; // cap 1m pulls so 8–34m resampling stays within plan limits

  const INFO = {
    box:  ROOT.querySelector('.cp-info'),
    sym:  ROOT.querySelector('.cp-info .sym'),
    name: ROOT.querySelector('.cp-info .name'),
    last: ROOT.querySelector('.cp-info .last')
  };
  const TF_BTN = ROOT.querySelector('.cp-tf');
  const TF_MENU = ROOT.querySelector('#cp-tf-menu');
  const SEARCH  = ROOT.querySelector('#cp-search');
  const W_BTN   = ROOT.querySelector('.cp-w');

// Chart: send symbol + TF to Trades widget
W_BTN.addEventListener('click', () => {
  try {
    // UI symbol from the chart header (fallback to current.symbol)
    const uiSym = (
      INFO?.sym?.textContent || current?.symbol || ''
    ).toString().trim().toUpperCase().replace(/[\/\-\s]/g, '');

    if (!uiSym) return;

    // Freeze the TF currently shown on the chart
    const tf = (window.CYCLA?.currentTF || current?.tf || '1m');
    (window.CYCLA.tfBySymbol ||= {})[uiSym] = tf;   // 🔒 freeze per symbol

    // Tell the rest of the app this symbol+TF was “watched”
    window.CYCLA.bus.dispatchEvent(new CustomEvent('cycla:watchlist:add', {
      detail: { symbol: uiSym, tf }
    }));
  } catch {}
});

  const TIP     = ROOT.querySelector('#cp-tip');

  // Crosshair overlay DOM
  const XHAIR_V_TOP = ROOT.querySelector('#xhair-v-top');
  const XHAIR_V_BOT = ROOT.querySelector('#xhair-v-bot');
  const XHAIR_H_BOT = ROOT.querySelector('#xhair-h-bot');

  // Chart theme (teal/purple)
  const COLORS = {
    up: '#14B8A6',
    upBorder: '#0F766E',
    down: '#723085',
    downBorder: '#6D28D9',
    wick: '#0A1F33',
    grid: 'rgba(10,20,40,.10)',
    text: '#1b2a4a',
    band: 'rgba(10,20,40,.55)',
    zero: 'rgba(10,20,40,.35)',
  };

  // TF map: native vs resample (from 1min)
  const TF = {
    '1m': { kind:'native', td:'1min' },
    '3m': { kind:'resample', base:'1min', mult:3 },
    '5m': { kind:'native', td:'5min' },
    '8m': { kind:'resample', base:'1min', mult:8 },
    '13m':{ kind:'resample', base:'1min', mult:13 },
    '21m':{ kind:'resample', base:'1min', mult:21 },
    '34m':{ kind:'resample', base:'1min', mult:34 },
    '1H': { kind:'native', td:'1h' },
    '1D': { kind:'native', td:'1day' },
    '1M': { kind:'native', td:'1month' },
  };

// ▼ add here
const TF_SEC = {
  '1m': 60, '3m': 180, '5m': 300, '8m': 480, '13m': 780, '21m': 1260, '34m': 2040,
  '1H': 3600, '1D': 86400, '1M': 2592000 // ~30d
};

function tfSeconds(tf){ return TF_SEC[tf] || 60; }

// ───────────────────────── Utilities ─────────────────────────
// Accept BTC-USD / BTC/USD / BTCUSD / BTCUSDT, etc.
// Convert to API symbol (BTC/USD) and UI symbol (BTCUSD)
const KNOWN_QUOTES = ['USDT','USDC','USD','EUR','GBP','JPY','AUD','CAD','CHF','CNY','HKD','BTC','ETH','SOL','BNB'];

const QUOTES_DESC = KNOWN_QUOTES.slice().sort((a,b)=>b.length-a.length);

function normalizeSymbol(raw) {
  let s = (raw || '').trim().toUpperCase();
  if (!s) return s;
  s = s.replace(/\s+/g, ''); // allow "btc usd" style input

  // If user typed separators, normalize to single slash
  if (s.includes('/') || s.includes('-')) {
    return s.replace(/-/g, '/').replace(/\/+/g, '/');
  }

  // If slashless, split BASE+QUOTE using known quotes (longest first, pre-sorted)
  for (const q of QUOTES_DESC) {
    if (s.endsWith(q) && s.length > q.length) {
      const base = s.slice(0, s.length - q.length);
      if (base.length >= 2 && base.length <= 6) {
        return `${base}/${q}`;
      }
    }
  }
  // Equities like AAPL just pass through
  return s;
}

